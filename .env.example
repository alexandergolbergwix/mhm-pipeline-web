# Copy to .env for local dev. NEVER commit a real .env.
# On Heroku, set these as Config Vars instead.

# ── Database ──────────────────────────────────────────────────────────
# Local dev (docker-compose):
DATABASE_URL=postgresql+asyncpg://mhm:mhm@localhost:5432/mhm_pipeline_web
# Heroku injects DATABASE_URL automatically as postgres:// — the app
# rewrites it to postgresql+asyncpg:// at startup.

# ── Server-held crypto keys (PII encryption + HMAC blind index) ──────
# Generate fresh values for each environment:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
MASTER_KEY=replace_me_32byte_urlsafe_token
EMAIL_HMAC_KEY=replace_me_32byte_urlsafe_token

# ── App ──────────────────────────────────────────────────────────────
ENV=development                  # development | production
COOKIE_SECURE=false              # set to true in production (HTTPS only)
SESSION_TTL_HOURS=12             # sliding session expiry
FRONTEND_ORIGIN=http://localhost:5173

# ── Optional: Postmark / SMTP for invitations (Phase 3) ──────────────
# DEPRECATED — replaced by RESEND_API_KEY below
# POSTMARK_TOKEN=
# MAIL_FROM=noreply@example.org

# ── Registration / spam protection ───────────────────────────────────
# Resend (https://resend.com) — transactional email provider.
# Create an API key at https://resend.com/api-keys.
RESEND_API_KEY=re_REPLACE_ME
# Verified sender. The display-name + address form is required by Resend.
RESEND_FROM_EMAIL="MHM Pipeline <noreply@example.org>"
# Where admin notifications about new access requests are delivered.
# Leave blank to disable admin notifications.
ADMIN_NOTIFICATION_EMAIL=

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# The values below are Cloudflare's documented always-pass test keys —
# replace with real keys before going to production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Double opt-in TTL (hours) for the confirm-your-email link in the
# request-access flow.
REQUEST_CONFIRM_TTL_HOURS=24
# TTL (hours) for the admin approve/deny links sent after a user
# confirms their access request. Default = 7 days.
ADMIN_DECISION_TTL_HOURS=168
