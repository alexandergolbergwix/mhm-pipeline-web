# Copy to .env for local dev. NEVER commit a real .env.
# On Heroku, set these as Config Vars instead.

# ── Database ──────────────────────────────────────────────────────────
# Local dev (docker-compose):
DATABASE_URL=postgresql+asyncpg://mhm:mhm@localhost:5432/mhm_pipeline_web
# Heroku injects DATABASE_URL automatically as postgres:// — the app
# rewrites it to postgresql+asyncpg:// at startup.

# ── Server-held crypto keys (PII encryption + HMAC blind index) ──────
# Generate fresh values for each environment:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
MASTER_KEY=replace_me_32byte_urlsafe_token
EMAIL_HMAC_KEY=replace_me_32byte_urlsafe_token

# ── App ──────────────────────────────────────────────────────────────
ENV=development                  # development | production
COOKIE_SECURE=false              # set to true in production (HTTPS only)
SESSION_TTL_HOURS=12             # sliding session expiry
FRONTEND_ORIGIN=http://localhost:5173

# ── Optional: Postmark / SMTP for invitations (Phase 3) ──────────────
# POSTMARK_TOKEN=
# MAIL_FROM=noreply@example.org
