# Python
__pycache__/
*.pyc
*.pyo
.venv/
.venv-*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
.vite/
*.log
.npm/
.pnpm-store/
*.tsbuildinfo
# Stale outputs from accidental ``tsc -b`` runs against vite.config.ts.
frontend/vite.config.js
frontend/vite.config.d.ts
frontend/vite.config.js.map

# Large authority data — Mazal SQLite is ~983 MB. The web backend reads
# from the user's desktop install via $MAZAL_DB_PATH (or, in prod, from
# a copy uploaded out-of-band).
backend/converter/authority/mazal_index.db
backend/data/mazal_index.db

# The placeholder pipeline we wrote before adopting the desktop copy.
backend/app/_pipeline_placeholder.bak/

# Env / secrets — NEVER commit these
.env
.env.local
.env.*.local

# Editors
.idea/
.vscode/
.DS_Store

# Build outputs
frontend/dist/
backend/dist/
build/

# Playwright run reports — regeneratable, large.
frontend/playwright-report/
frontend/test-results/


# Run state artefacts — regeneratable from MARC inputs.
backend/state/
backend/uploads/
backend/runs/
backend/tmp/

# ── Secrets & credentials — NEVER commit any of these ─────────────────
# Generic env-shaped files (catch dotenv files in subdirectories too).
.env
.env.*
!.env.example
.envrc
secrets.json
secrets.yaml
secrets.yml
*.credentials
credentials.json
service-account*.json
gcloud-*.json

# Cloud / SaaS CLI state (token caches).
.aws/
.azure/
.gcp/
.kube/
.modal/
.heroku/
.netrc

# Private keys + certs (any depth).
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ed25519
id_ed25519.*
*.kdbx
*.gpg

# Database / data dumps — keep these out of git regardless of location.
*.db
*.db-journal
*.sqlite
*.sqlite3
*.dump
*.sql.gz
*.tar.gz
*.tgz
*.zip
*.bak
*.backup
# Re-allow the small KIMA reference DB which IS committed on purpose.
!backend/data/kima/kima_index.db

# Model weights & big ML artefacts (in case they ever drop into the repo).
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.gguf
*.pkl
*.joblib
# Anchored at repo root so we don't shadow legit subdirs like
# backend/app/models/ (the SQLAlchemy ORM package).
/models/
/weights/
.cache/
.cache/huggingface/

# Heroku slug / build artefacts.
slug.tgz
release.tar.gz
.profile.d/

# IDE / editor extras (beyond .idea + .vscode + .DS_Store above).
.history/
.idea_modules/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
._*
Thumbs.db

# Tooling caches.
.eslintcache
.stylelintcache
.parcel-cache/
.turbo/
.next/
.tox/
.nox/
.cache_ggshield
.ipynb_checkpoints/

# Coverage / profiling.
.coverage
.coverage.*
coverage.xml
coverage/
*.prof
*.lcov

# Scratch dirs — anchored at repo root so subdir names with the same
# spelling (e.g. some library's tmp/ helper) aren't accidentally shadowed.
/tmp/
/scratch/
/private/
/personal/

# Local production snapshots (see snapshots/README.md)
snapshots/*.json


# dev-3.0 local config
.dev3/config.local.json
