    hm:has_production_event hm:Production_990038692590205171 ;
    hm:has_rights_determination hm:Rights_990038692590205171 ;
    hm:has_text_tradition hm:TextTradition_משנה_תורה_ספר_הפלאה_זרעים_עבודה_קרבנות_tradition ;
    hm:has_work hm:Work_משנה_תורה_ספר_הפלאה_זרעים_עבודה_קרבנות_by_משה_בן_מימון ;
    hm:is_composed_of hm:CU_990038692590205171_main ;
    hm:ownership_history "ציון בעלים (13א): \"\"הדא אלכתאב ליחיא בן אברהם אלבשירי ראין ביד סלימאן בן יוסף אללוי פי כמסה ד'הב בחצ'רתנא נחן אלשהוד אלואצעין בטוטנא אספל ... סעדיא בן שלמה ושל זכריא בכמח\"\"ר סעדיא ...\"\" [היינו יחיא בן אברהם אלבשירי נתן את הספר למשכון בידי סלימאן בן יוסף הלוי בעד חמשה זהובים]."^^xsd:string ;
    hm:witnesses hm:TextTradition_משנה_תורה_ספר_הפלאה_זרעים_עבודה_קרבנות_tradition ;
    rdfs:comment "\"\"על ענין המעשר בזמן הזה\"\" (שם סי' קלג), על ענין מאימתי מונין לשמיטות (שם סי' רלד), על מוציא שם רע (שם סי' קעג), על אסור לאדם שיהנה ממון חבירו (מהדורת בלאו, סי' תמד), בענין הפקדה הדדית (פריימאן סי' רפו), תשובות נוספות (בלאו, סי' תמב, תמג, שנט, תכח, שפד, שלח, שו, שא, שמג, שנו, תכד, שנז, תלה)."@he,
        "BIBLIOGRAPHIC_50929717600005171_1.txt"@he,
        "בראש כתב היד רשימת ספרים."@he,
        "בראש כתב-היד חיבורים נוספים מאת הרמב\"\"ם:"@he,
        "דף 1ב-2ב: ספר הצווי מאת משה בן מימון, פותח: \"\"זה הקונדריס מדבר בדברי מוסר וצוואה שצוה הרב הגדול רבינו משה בן מימון ז\"\"ל לבנו החכם ר' אברהם ומקצתו כתוב בו שאלות ותשובות מהרב הנזכר ז\"\"ל\"\". הצוואה קצרה יותר מהנוסח שפרסם ש\"\"א וורטהיימר, בספר ספר זכרון לראשונים ולאחרונים (ירושלים תרס\"\"ט) ופותח: \"\"דע בני אברהם ירחמך האל ית' כי ראוי לנו שנדע באמת ...\"\"."@he,
        "דף 2ב-15ב: \"\"אלה הם שאלות תשובות להרב הגדול רבינו משה בן מימון ז\"\"ל\"\". כולל תשובה שהשיב לרב אברהם הכהן בבגדאד (תשובות הרמב\"\"ם, מהדורת א' פריימאן, ירושלים תרצ\"\"ד, סי' סז), תשובת \"\"רב שמואל הלוי ראש הישיבה\"\" לאות שאלה (שם, סי' סח), ו\"\"תשובת ... הר\"\"ם במז\"\"ל\"\" על תשובתו של הרב שמואל הלוי (שם, סי' סט), תשובה על קריאת התורה מחומשים (שם, סי' מג) ותשובה אחרת באותו ענין ש\"\"השיבו חכמי נרבונה\"\" (נדפסה בס' שו\"\"ת בעלי התוספות סי' טז, כלבו סי' כ ועוד), תשובה בענין גט שכותבים \"\"כל היוצא למלחמת בית דויד\"\" (אגרות תשובות הרמב\"\"ם, תרי\"\"ט, עמ' 100), תשובה על מורדת (פריימאן, סי'קצד), תשובה בענין סריס (שם, סי' קנג), תשובות לעובדיה הגר (שם, סי' מב, סי' שמד), על צדוקים (שם, שס\"\"ה), על מעלין לכהונה על פי עד אחד (שם סי' שנב), על איך להתנהג עם הקראים (שם, סי' שעא), על כיוון התפילה בבית כנסת (שם סי' יט), בענין ברכה על אכילת ירק בליל הסדר (שם, סי' עז), על קדירה של דיסא שמשהין אות על כירה בשבת (שם סי' סג), תשובה על מי שנשבע שלא יפרוש לים (שו\"\"ת פאר הדור, סי' יג), על אשה שנשתמד בעלה בארץ אחרת (פריימאן, סי' רב), ענין עגונה (שם סי' קנט), בענין תנאי בגירושין (אגרות תשובות הרמב\"\"ם, תרי\"\"ט, עמ' 116) על ברכת אירוסין (פריימאן, סי' ו), על בישולי גוים (שם סי' צה),"@he,
        "עם הערות וביאורים בעברית (מספר הטור, הערוך, רמב\"\"ן ועוד) ובערבית בשוליים."@he .

