hm:MS_990001882630205171 a lrmoo:F4_Manifestation_Singleton,
        hm:Bibliographic_Unit ;
    rdfs:label "מלאכת שלמה (סדר זרעים)."@he ;
    lrmoo:R4_embodies hm:Expression_מלאכת_שלמה_סדר_זרעים_in_990001882630205171 ;
