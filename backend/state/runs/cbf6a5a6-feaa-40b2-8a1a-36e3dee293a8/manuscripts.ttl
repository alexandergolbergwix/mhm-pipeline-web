    hm:is_composed_of hm:CU_990001340200205171_main ;
    hm:mentions_place hm:Place_Rotterdam_Netherlands ;
    hm:ownership_history "בראש כה\"\"י ציון בעלים: \"\"כי ישאלך איש לאמר למי אתה אמור אני שייך ליצחק בן פו\"\"ם הח' ר' ברוך זצ\"\"ל, J.B Samson, לזכרון ההגדה הזאת כתב דד של אבי זקני ר' נתן בן הרב מוהר\"\"ר שמשון ונתן במתנה להח' ר' שמשון בן הח' ר' יצחק והוא נתן מתנה לבנו הח' ר' שואל והוא נתן לאחיו הח' ר' ברוך והוא נתן לבנו יצחק בן הח' ר' ברוך זצ\"\"ל\"\"."^^xsd:string ;
    hm:witnesses hm:TextTradition_הגדה_של_פסח_tradition ;
    rdfs:comment "BIBLIOGRAPHIC_50929717600005171_2.txt"@he,
        "בשער המצויר: \"\"סדר הגדה של פסח עם ציורים נאים\"\"."@he,
        "הוראות לסדר ביידיש וכן תרגום של הפיוטים \"\"אדיר הוא\"\", \"\"אחד מי יודע\"\" ו\"\"חד גדיא\"\"."@he,
        "נושא נוסף: היסטוריה. רשימות משפחתיות. שמשון, יצחק בן ברוך"@he,
        "נושא נוסף: כתב-יד. העברה"@he,
        "נושא נוסף: ציורים"@he,
        "נושא נוסף: תפלה הגדה של פסח מנהג אשכנז"@he,
        "נושא נוסף: תפלה הגדה של פסח תרגומים יידיש"@he,
        "עם ניקוד."@he,
        "עם ציורים."@he .

