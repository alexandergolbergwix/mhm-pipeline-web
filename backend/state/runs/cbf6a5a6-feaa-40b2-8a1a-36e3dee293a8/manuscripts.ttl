    hm:mentions_place hm:Place_Jerusalem_Israel ;
    hm:ownership_history "בראש כה\"\"י רשימות בעלים: \"\"אני הצעיר משה בכמהר\"\"ר שמואל הנאמן\"\" שאף העתיק קטעים אחדים בטטרית (1ב); \"\"באתי אני הדל ... דוד נשיא נשיא[!] רופא בכר' אבי ... אהרן הנשיא ... וגם עמי בן דודי כר' אליהו נשיא בכר' מרדכי נשיא ..."^^xsd:string ;
    hm:witnesses hm:TextTradition_כתר_תורה_tradition ;
    rdfs:comment "BIBLIOGRAPHIC_50929717600005171_4.txt"@he,
        "בדף 278ב: \"\"זה השיר חברו כהר' יצחק בכהר' משה פשא נ\"\"ע\"\" פותח: \"\"אנשי אמונים דרשו היטב\"\"."@he,
        "בכה\"\"י: \"\"ספר כתר תורה למורנו הרב ... אהרן בר' אליהו ניקומידיאו\"\""@he,
        "בסוף שיר הפתיחה תאריך החיבור: \"\"אהרן בן אליהו ילדו שנת הקכ\"\"ב למנין הברואים\"\"."@he,
        "נושא נוסף: כתות קראים. מקרא פרשנות תורה (אהרן בן אליהו מניקומדיה)"@he,
        "על המחבר וחבוריו ראה: י' מאן, T&S חלק שני, עמ' 1417."@he .

