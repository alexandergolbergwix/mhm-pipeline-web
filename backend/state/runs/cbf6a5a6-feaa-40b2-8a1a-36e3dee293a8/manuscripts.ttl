        hm:Place_Sataniv_Ukraine,
        hm:Place_Venice_Italy ;
    hm:witnesses hm:TextTradition_לקט_מכתבים_tradition ;
    rdfs:comment "\"\"בקשה\"\" מאת ר' יהודה אלחריזי,]ותחת: \"\"אנא אדון עולם ובורא הברואים כלם\"\" (193ב)."@he,
        "\"\"זו שדרשתי היום יום ה' יט לכסלו שנת בישע לפ\"\"ק [=שפ\"\"ב] לתשלום הז' ימים של הר\"\"ר יוזלן מפראג יצ\"\"ו\"\" (161א-162ב). \"\"דרשתי על אלופנ' ומיודענ' הישיש ... הה\"\"ר נח זצ\"\"ל ... השפ\"\"ב ליצירה כ\"\"ב לטבת והוא תשלום השנה\"\" (165א-168ב)."@he,
        "\"\"כללי התלמוד\"\" (קטע, 7א). יתכן שאף חיבור זה מפרי עטו."@he,
        "\"\"מילי דשמיא\"\" מאת ר' \"\"אלעזר אזקרי\"\" - פרקי מוסר אלו הן טיוטות ראשונות של חיבורו ספר חרדים (5ב, 6ב, 11א-14ב, 17ב-23ב, 25א-26ב, 196ב-200ב, 203א-205ב, 211ב) במקומות שונים מצויינות השנים: שמ\"\"ה-שמ\"\"ט (6ב, 203א-203ב, 205א)."@he,
        "\"\"פנקס של ירושלים ע\"\"ה תוב\"\"ב\"\" פנקס חשבונות של ק\"\"ק ירושלים,"@he,
        "216א ושם: \"\"ושמעתי פירוש לפירושו אני אלעזר אזכרי מפי מורי החכם החסיד כה\"\"ר יוסף שאגיש זלה\"\"ה ששמע מרבו הרב ר' יוסף טייטצק זלה\"\"ה\"\"."@he,
        "BIBLIOGRAPHIC_50929717600005171_1.txt"@he,
        "בין החטיבות הנ\"\"ל ובתוכן שולבו רשימות מיומנו המיסטי של ר' אלעזר אזכרי (1ב, 5א, 128ב-129א, 194ב, 210ב, 214א, 219א). קטעים נוספים של אותו יומן מצויים בבית המדרש לרבנים בניו יורק 809 R (בפירושו לירושלמי מסכת ביצה)."@he,
        "בין השאר מציין הכותב: \"\"מצאתי במדרש מעין גנים שא' שראה ספר כתוב בו כי בספרד באר מים נובעים כל אשה שהית' שותה ממנו נעשי' זונה ואפי' היתה היותר צנועה עד שעמדו אנשי המקום וסתמו אותו\"\" (7ב);"@he,
        "בכה\"\"י: רובם מאת ר' \"\"אלעזר אזקרי\"\""@he,
        "בכתיבה אשכנזית שניהל גזבר הקהילה בין השנים שע\"\"ב-שפ\"\"ט בדפים נפרדים או בשולי עמודים המכילים טכסטים שונים (98ב, 128ב, 136ב-137ב, 139ב-144א, 145א-147א, 148ב, 149ב, 160ב, 164ב, 168ב-170ב, 215א-215ב)."@he,
        "בראשו מביא הוא את האגרת ששיגר ר' חיים בן מהר\"\"ר נפתלי זלה\"\"ה הנקרא ר' הירש שור ז\"\"ל מסאטנב\"\" אל \"\"כמהר\"\"ר מרדכי כ\"\"ץ\"\" אודות פלאותיו של הנער בן ר' \"\"גדליא\"\" שנדפס כבר בספר אילם ליש\"\"ר מקנדיא, אמשטרדם שפ\"\"ט, דף סה, וספור נוסף אודות \"\"הנער מק\"\"ק פאטליטץ\"\","@he,
        "ברכות (171א-171ב, 183א-186א, 209ב-210א, 216א-217ב), יום טוב (=ביצה, 218א-219א), שבת (84א, 178א-178ב, 182א-182ב, 188א-191א) ומועד קטן (193ב-194ב)."@he,
        "ברשימת התורמים מ\"\"פראג\"\": \"\"יצחק הכהן יצ\"\"ו חתן הרב מהר\"\"ר ליב בצלאל ז\"\"ל\"\" - המהר\"\"ל (140א), הכותב היה חתנו של הנדבן \"\"נח\"\" הנ\"\"ל ש\"\"החזיק ההסגר שלנו\"\" וגם בני משפחתו המשיכו לתרום לאחר מותו (170א)."@he,
        "גיטין (132א-135ב), כתובות (54א-55א, 153א-153ב, 154ב-156ב), [בבא] קמא (171א-174, 176א-177ב, 179ב-180א), קדושין (191ב-193א), תענית (186א-188א, 209א)."@he,
        "דרשה על פרשת בהר מ\"\"מהרי\"\"ק\"\" - ר' ישראל דיקוריאל? - מחכמי צפת במחצית השניה של המאה הט\"\"ז (117ב-119ב) ושם (118ב): \"\"ושמעתי מפי חכם זקן שמו ה\"\"ר יוסף חדירי ז\"\"ל\"\"; \"\"ושמעתי מחברנו הרמ\"\"א נר\"\"ו\"\" (127א);"@he,
        "דרשות לתורה ולעניינים אחרים להנ\"\"ל (2א-2ב, 58ב-116ב, 127ב-128א, 129א-131ב, 136א, 138א-138ב, 140א-142א, 143א, 144א-144ב, 163א-164ב, 177ב, 179א-181א, 194ב-196ב."@he,
        "הלה חותם על שטר בענייני אישות שעליו חתומים: \"\"יוסף פינטו\"\" ו\"\"משה בכ\"\"ר יוסף זלה\"\"ה ...\"\" בשנת \"\"השמ\"\"ד\"\" (197ב)."@he,
        "המחבר ישב בירושלים ומזכיר את חמיו: \"\"מורי חמי ורבי ז\"\"ל החזיק ההסגר [=ישיבה] שלנו זה כמה שני' ... וגם שאר צדקות שעשה\"\" (165ב)."@he,
        "העתק אגרת ששלח \"\"יהוד' שאול בר דוד ז\"\"ל איש קאסטליץ שמש דלבוב אל ה\"\"מקובל האלהי הגאון מוהר\"\"ר חיים ויטאל ז\"\"ל\"\" אודות פלאיו של נער אחד בפולין\"\" (181א-181ב)."@he,
        "הפיוט \"\"ידיד נפש אב הרחמן\"\" בכתיבת ידו (5ב)."@he,
        "השווה מהדורת מ' פכטר, מילי דשמיא לר' אלעזר אזכרי, תל אביב, תשנ\"\"א."@he,
        "ושם כותב הוא בין השאר: \"\"כשנתבקש הגאון החסיד הטהור מוהר\"\"ר יצחק לוריא לישיבה של מעלה אז קודם מותו גילה את מכ\"\"ת שנער א' יהיה בארץ אדום שיגיד נפלאות ונוראות\"\"."@he,
        "כולל בין השאר רשימות של הוצאות והכנסות (תרומות מקהילות שונות ב\"\"אשכנז\"\" מערב אירופה, מרכזה ומזרחה - פולין, וכן מקהילות \"\"ויניציאה\"\" וקהילות הראשיות תחת שלטונם של העות'מאנים)."@he,
        "כרוניקה - קינה על גירוש ספרד שהעתיקה שלא בשלמות ר' אלעזר אזכרי (3א). פורסמה על-ידי י' הקר, כרוניקות חדשות על גירוש היהודים מספרד, סיבותיו ותוצאותיו, ציון, מד (תשל\"\"ט-תשמ\"\"א), עמ' 206-207, 209, 223-228."@he,
        "כתבי ר' אלעזר אזקרי בכתיבת ידו מחולקים לשלש חטיבות עיקריות ללא סדר. ושולבו בהם דפים ורשימות מחבורי קודמיו, וכן מחבורים מאוחרים יותר שצורפו מאוחר יותר לקובץ זה."@he,
        "מודגשות תרומות שהגיעו ל\"\"הסגר\"\" - \"\"ישיבת ק\"\"ק אשכנזים\"\" וישיבות אחרות וכן תרומות לקהלות \"\"צפת\"\" ו\"\"חברון\"\"."@he,
        "נושא נוסף: אוטוגרף. אזקרי, אלעזר"@he,
        "נושא נוסף: דרשות"@he,
        "נושא נוסף: היסטוריה. כרוניקות. גרוש ספרד"@he,
        "נושא נוסף: היסטוריה. מקומות. ספרד"@he,
        "נושא נוסף: היסטוריה. פנקסי קהילות. ירושלים"@he,
        "נושא נוסף: ישיבה"@he,
        "נושא נוסף: מוסר"@he,
        "נושא נוסף: קבלה"@he,
        "נושא נוסף: שטרות"@he,
        "נושא נוסף: תלמוד בבלי פרשנות (אזקרי, אלעזר)"@he,
        "נושא נוסף: תלמוד ירושלמי פרשנות סדר קדשים בכורות (אזקרי, אלעזר)"@he,
        "נושא נוסף: תלמוד כללים"@he,
        "נושא נוסף: תפלה. פיוטים"@he,
        "ניזכרים אישים רבים שהיו קשורים לענייני הקהלה הירושלמית, ביניהם: \"\"חייא רופא\"\", \"\"אברהם סוריאנו\"\", \"\"אלמנת מהר\"\"ר שמשון בק\"\", ר' \"\"יום טוב צהלון נר\"\"ו\"\" (137א-137ב),"@he,
        "פורסמה בשנית על-ידי מ' בניהו, מקור לתולדות גירוש ספרד, סיני, פח (תשמ\"\"א), עמ' מ-מז."@he,
        "פרושים וחדושים על מסכתות בתלמוד הבבלי להנ\"\"ל: חולין (5א-6ב, 8א, 208א), שבועות (23א-23ב, 213א, 215ב), נדרים הנקראת \"\"פרי מגדים\"\" (27א, 28א, 34א-53ב, 55א-58א ושם: \"\"סוף אדר שני שנת ש'א'ל'ו' שלום ירושלים לפרט\"\" [=של\"\"ז],"@he,
        "פרקי היומן משתרעים על תקופה של שלשים וחמש שנה משנת שכ\"\"ד-שנ\"\"ט, ראה: מ' פכטר, חייו ואישיותו של ר' אלעזר אזכרי בראי יומנו המסטי וספר חרדים, שלם, ג (תשמ\"\"א), עמ' 127-147."@he,
        "קטע מפירושו של ר' אלעזר אזכרי ל\"\"ירושלמי דבכורות\"\" (208ב-209ב)."@he,
        "שורבבו דפים מחבורים שונים בתחום המדרש, פרשנות המקרא ופרשנות התלמוד בכתיבות אשכנזיות מן הרבע הראשון של המאה הי\"\"ז (7ב, 8ב, 27ב, 117א-122ב, 123ב-127א, 150ב-151ב, 152ב, 157א-160א, 161א-162ב, 165א-165ב, 167א-168ב, 181א-181ב),"@he .

