    hm:ownership_history "ציון בעלים (בראש עמוד השער): \"\"נתן בן ... שמעון אדלר כ\"\"ץ\"\"."^^xsd:string ;
    hm:witnesses hm:TextTradition_פרי_עץ_חיים_tradition ;
    rdfs:comment "BIBLIOGRAPHIC_50929717600005171_4.txt"@he,
        "בכה\"\"י: \"\"פרי עץ חיים ... חבור ... חיים וויטאל\"\""@he,
        "במקומות אחדים הגהות \"\"צמח\"\"."@he,
        "בעריכת מאיר פופרש."@he,
        "כולל: פרי עץ חיים ענף ראשון, \"\"ענף שני מפרי עץ החיים, שער המצות\"\", \"\"ענף הג' פע\"\"ח והוא תיקוני עוונות\"\" ו\"\"שער הנבואה ורוח הקדש והייחודים\"\"."@he,
        "נושא נוסף: קבלה"@he,
        "עם הערות והוספות בשוליים ובסופו השערים."@he .

