    hm:has_work hm:Work_מלאכת_שלמה_סדר_זרעים_by_עדני_שלמה_בן_ישועה ;
    hm:is_composed_of hm:CU_990001882630205171_main ;
    hm:mentions_place hm:Place_Israel ;
    hm:ownership_history "כה\"\"י נמכר למוכר ספרים."^^xsd:string ;
    hm:witnesses hm:TextTradition_מלאכת_שלמה_סדר_זרעים_tradition ;
    rdfs:comment "BIBLIOGRAPHIC_50929717600005171_5.txt"@he,
        "בהקדמתו לחבור מוסר המחבר פרטים אוטוביאוגרפיים שונים."@he,
        "בכה\"\"י: \"\"מלאכת שלמה\"\" מאת \"\"שלמה בן ... ה\"\"ר ישועה ... העדני\"\""@he,
        "בראשו רשם המחבר זכרונות שונים, בין השאר: על חלומותיו בשנת שפ\"\"ג, על הולדת בתו \"\"חנה\"\" באותה שנה ואודות \"\"עוצר גשמים\"\" (בצורת) שהיה ב\"\"ארץ ישראל\"\" ב\"\"שנת שפ\"\"ב\"\" ש\"\"נחרבו רוב הכפרים שבא\"\"י ובחסד אל יתברך שבאו כמה ספינות ממצרים נושאות בר ולחם ומזון\"\"."@he,
        "זכרונות אלו פורסמו על-ידי י' רצהבי, ר' שלמה עדני וחיבורו מלאכת שלמה, סיני, קו (תש\"\"ן), עמ' רנג-רנד."@he,
        "נושא נוסף: אוטוגרף. עדני, שלמה בן ישועה"@he,
        "נושא נוסף: תלמוד משנה פרשנות סדר זרעים (עדני, שלמה בן ישועה)"@he .

