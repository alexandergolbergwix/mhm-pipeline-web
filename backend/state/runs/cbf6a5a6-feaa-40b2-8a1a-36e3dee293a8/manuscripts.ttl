    hm:has_scribal_intervention hm:HandChange_990001039720205171,
        hm:Intervention_990001039720205171_Interlinear_addition_type ;
    hm:has_text_tradition hm:TextTradition_שתיל_פורח_tradition ;
    hm:has_work hm:Work_שתיל_פורח_by_מודנה_אהרן_ברכיה_בן_משה ;
    hm:is_composed_of hm:CU_990001039720205171_main ;
    hm:witnesses hm:TextTradition_שתיל_פורח_tradition ;
    rdfs:comment "BIBLIOGRAPHIC_50929717600005171_1.txt"@he,
        "בכה\"\"י: \"\"שתיל פורח\"\" מאת \"\"אבמ\"\"י\"\""@he,
        "דף 132א-137ב: סדר תקיעת שופר על דרך הקבלה, בכתיבה שונה."@he,
        "דף 138א-154א: הוספות, כנראה לס' שתיל פורח."@he,
        "החבור כולל כוונות התפילה לכל השנה עפ\"\"י קבלת האר\"\"י."@he,
        "נושא נוסף: אוטוגרף. מודינא, אהרן ברכיה"@he,
        "נושא נוסף: קבלה"@he,
        "קולופון המחבר בדף 131ב: \"\"בי\"\"ו[?] לחדש מנחם השפ\"\"ט\"\" (וראה: י' תשבי, ציון לט (תשל\"\"ד), עמ' 69)."@he .

hm:MS_990035044030205171 a lrmoo:F4_Manifestation_Singleton,
        hm:Bibliographic_Unit ;
    rdfs:label "ספר החרוזים."@he ;
    lrmoo:R4_embodies hm:Expression_ספר_החרוזים_in_990035044030205171 ;
    hm:external_identifier_nli "990035044030205171"^^xsd:string ;
    hm:has_acquisition_event hm:Acquisition_990035044030205171_01 ;
    hm:has_digital_access hm:DigitalAccess_990035044030205171 ;
    hm:has_digital_representation_url "https://digitalcollections.jtsa.edu/islandora/object/jts%3A102704#page/1/mode/1up"^^xsd:anyURI ;
    hm:has_expression hm:Expression_ספר_החרוזים_in_990035044030205171 ;
    hm:has_philological_perspective hm:PhilologicalView_990035044030205171 ;
    hm:has_philological_witness hm:Witness_ספר_החרוזים_in_990035044030205171 ;
    hm:has_production_event hm:Production_990035044030205171 ;
    hm:has_rights_determination hm:Rights_990035044030205171 ;
    hm:has_scribal_intervention hm:Intervention_990035044030205171_Interlinear_addition_type ;
    hm:has_text_tradition hm:TextTradition_ספר_החרוזים_tradition ;
    hm:has_work hm:Work_ספר_החרוזים ;
    hm:is_composed_of hm:CU_990035044030205171_main ;
    hm:ownership_history "ציון בעלים (2א): \"\"אשר ויטרבו\"\"."^^xsd:string ;
    hm:witnesses hm:TextTradition_ספר_החרוזים_tradition ;
    rdfs:comment "BIBLIOGRAPHIC_50929717600005171_3.txt"@he,
        "בראשו (2א): \"\"ספר החרוזים הועתק מספר ישן כתיבת יד ע\"\"י נכדי בחור מעם המשכיל על דבר ימצא חן ושכל טוב ביעני אלקים ואדם הוא הנעים שמואל יזיי\"\"א בהמ' אברהם זלה\"\"ה ממונדולפו אחי ...\"\"."@he,
        "מיוסד על ס' ערמת חטים מאת יהודה דה פורטה, עם הוספות. לפי דעת קאסוטו המחבר הוא שלמה מפונציבוצי, מעתיק העותק בכתב-יד ניו-יורק, בית המדרש לרבנים 10612 (לפנים לונדון, בית הדין 141), אך חיבור זה נמצא בכ\"\"י רבים מאותה תקופה בלי ייחוס (ראה: ש' סימונסון, \"\"מאגרוניו של שלמה מפונציפונצי\"\", קבץ על יד, ו, תשכ\"\"ו, ב, עמ' 384, הערה 20). השווה כ\"\"י בודפשט-קויפמן 48 (ס' 2849)."@he,
        "נושא נוסף: בלשנות מלונים לחרוזים"@he .

