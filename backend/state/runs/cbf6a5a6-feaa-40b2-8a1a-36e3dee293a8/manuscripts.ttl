    hm:is_composed_of hm:CU_990000856010205171_main ;
    hm:mentions_place hm:Place_Egypt,
        hm:Place_Erakleion_Greece,
        hm:Place_Hebron_West_Bank,
        hm:Place_Jerusalem_Israel,
        hm:Place_Safed_Israel ;
    hm:witnesses hm:TextTradition_קונטרס_בית_כנסת_בקהילת_קנדיאה_tradition ;
    rdfs:comment "BIBLIOGRAPHIC_50929717600005171_1.txt"@he,
        "בין השאר תרם צדקה ל\"\"ראשי ישיבות\"\" ב\"\"חברון\"\", \"\"צפת\"\" ו\"\"ירושלם\"\" וכן תרומותיו לשני בתי כנסיות בקנדיאה: \"\"כנסת העליון של קזאני\"\" ו\"\"בית הכנסת כהנים\"\", נזכר גם אחיו \"\"מלכיאל\"\" וכן אלמנתו \"\"פנוריאה\"\" שתרמה \"\"בכל אחד מהארבעה בתי כנסיות של קהילתנו\"\""@he,
        "בכה\"\"י: \"\"תיקון עזרא\"\""@he,
        "ובקהלות ק\"\"ק מצרים ואגפיה\"\"; \"\"מלכיאל קזאני ... בן ... כמוהר\"\"ר משה\"\"; \"\"יאודה קזאני ... בן ... כמוהר\"\"ר זרחיא\"\"; \"\"החכם הכולל ... כמוהר\"\"ר שמואל קזאני אביר הרפאים\"\". מזה האחרון מובא תאור נרחב על פועליו החשובים במעשי צדקה ובריפוי חולים,"@he,
        "וכן \"\"אלונה ... אלמנת הישיש ... מכיר משריטי ... ובת החכם ... כמהר\"\"ר משה הכהן אשכנזי הרופא טבעי\"\" נזכר גם \"\"שלמה כהן בלבו\"\"."@he,
        "כולל: \"\"סדר קריאת השבוע\"\" ו\"\"סדר קריאת השבתות\"\" ומועדים, \"\"מי שברך\"\" (54א-55ב), כולל גם נוסח ביוונית, \"\"יקום פורקן\"\", \"\"אב הרחמים\"\", ו\"\"יזכור\"\" לאישים מרכזיים בקהילת קנדיאה (חכמים ונדבנים. 59ב-73א)."@he,
        "מרבית האישים הנזכרים ב\"\"יזכור\"\" הם בני משפחת \"\"קזאני\"\" ובכללם: \"\"שבתי קזאני\"\" ו\"\"מלכיאל\"\" אחיו \"\"שהכינו בה\"\"כ [=בית הכנסת] הזה לתפלה\"\"; \"\"כמוהר\"\"ר משה קזאני\"\"; \"\"זרחיה קזאני ... בן ... כמהר\"\"ר מלכיאל קזאני ... שהרביץ תורה בישראל בכל קהילות אי קנדיאה"@he,
        "מרבית האישים מוזכרים בתקנות קנדיאה וזכרונותיה. בעריכת א\"\"ש הרטום ומד\"\"א קאסוטו, ירושלים תש\"\"ג."@he,
        "נושא נוסף: בית כנסת"@he,
        "נושא נוסף: ישיבה"@he,
        "נושא נוסף: תפלה"@he .

