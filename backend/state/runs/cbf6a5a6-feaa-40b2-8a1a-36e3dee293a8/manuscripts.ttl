hm:MS_990000759620205171 a lrmoo:F4_Manifestation_Singleton,
        hm:Bibliographic_Unit ;
    rdfs:label "מגיד מישרים."@he ;
    lrmoo:R4_embodies hm:Expression_מגיד_מישרים_in_990000759620205171 ;
    hm:external_identifier_nli "990000759620205171"^^xsd:string ;
    hm:has_colophon hm:Colophon_990000759620205171 ;
    hm:has_expression hm:Expression_מגיד_מישרים_in_990000759620205171 ;
    hm:has_philological_perspective hm:PhilologicalView_990000759620205171 ;
    hm:has_philological_witness hm:Witness_מגיד_מישרים_in_990000759620205171 ;
    hm:has_production_event hm:Production_990000759620205171 ;
    hm:has_rights_determination hm:Rights_990000759620205171 ;
    hm:has_script_type hm:ByzantineScript ;
    hm:has_text_tradition hm:TextTradition_מגיד_מישרים_tradition ;
    hm:has_work hm:Work_מגיד_מישרים_by_קרו_יוסף_בן_אפרים ;
    hm:is_composed_of hm:CU_990000759620205171_main ;
    hm:mentions_place hm:Place_Istanbul_Turkey,
        hm:Place_Safed_Israel ;
    hm:witnesses hm:TextTradition_מגיד_מישרים_tradition ;
    rdfs:comment "BIBLIOGRAPHIC_50929717600005171_3.txt"@he,
        "בסדר כרונולוגי מכ' אדר א (רצ\"\"ו?) עד שבט (ולא כמו בדפוסים לפי הפרשיות)."@he,
        "בסוף כה\"\"י נוספו קטעים מכתבי יד אחרים: קטעים משתי אגרות בענין אדם שרצה לשאת אשה על אשתו. באגרת הראשונה מוזכר \"\"פה צפת\"\". ובשניה נזכרת \"\"[אשת?] כמה\"\"ר יוסף הכהן נר\"\"ו הלכה לה עם החכם בנה יצ\"\"ו [ובנ]ה הנז' נשאר פה קושטדינה\"\""@he,
        "בסופו (דף 111א) קולופון: \"\"נשלם העתק זה יום ו'(?) ה' חשון הת\"\"ט\"\"."@he,
        "בסופו נכרך גם דף מדפוס."@he,
        "וגם בה נזכר \"\"צפת\"\" (בכתיבה מזרחית מהמאה הי\"\"ז) וקטע נוסף מכ\"\"י בכתיבה ביזנטית מהמאה הי\"\"ד-ט\"\"ו ובו קטע מפרוש התורה (מסוף שמות ומתחילת ויקרא)."@he,
        "נושא נוסף: קבלה"@he .

hm:MS_990000776020205171 a lrmoo:F4_Manifestation_Singleton,
        hm:Bibliographic_Unit ;
    rdfs:label "נר ה'."@he ;
    lrmoo:R4_embodies hm:Expression_נר_ה_in_990000776020205171 ;
    hm:external_identifier_nli "990000776020205171"^^xsd:string ;
    hm:has_acquisition_event hm:Acquisition_990000776020205171_01 ;
    hm:has_expression hm:Expression_נר_ה_in_990000776020205171 ;
    hm:has_philological_perspective hm:PhilologicalView_990000776020205171 ;
    hm:has_philological_witness hm:Witness_נר_ה_in_990000776020205171 ;
    hm:has_production_event hm:Production_990000776020205171 ;
    hm:has_rights_determination hm:Rights_990000776020205171 ;
    hm:has_text_tradition hm:TextTradition_נר_ה_tradition ;
    hm:has_work hm:Work_נר_ה_by_סיד_שמואל_בן_מרדכי_אבן ;
    hm:is_composed_of hm:CU_990000776020205171_main ;
    hm:mentions_place hm:Place_Alexandria_Egypt,
        hm:Place_Egypt,
        hm:Place_Hebron_West_Bank,
        hm:Place_Jerusalem_Israel ;
    hm:ownership_history "ציון בעלים (בראשו): \"\"זה הספר קניתי אותו לעבודת קוני מיד הח' אהרן אמאטו נר\"\"ו ... היום תשעה באב משנת התק\"\"ך הצעיר משה טאריף בן לא\"\"א החכם השלם כמה\"\"ר ידידיה טאריף נר\"\"ו\"\"."^^xsd:string ;
    hm:witnesses hm:TextTradition_נר_ה_tradition ;
    rdfs:comment "\"\"תלמידו כה\"\"ר שלום בן אחיו הגדול כה\"\"ר יצחק ן' סיד נר\"\"ו בתשלום שנת אמו שנת ש'ל'ו'ם' [=שע\"\"ו] (בהעלותך) בסופו של ההספד נזכר: \"\"בפ' בהעלותך באה שמועת הרב כמהר\"\"ר יוסף המקובל זלה\"\"ה בנא אמון\"\" הוא תאריך פטירת יוסף ן' טבול (דף 134א); ר' \"\"שמואל לניאדו\"\" (קרח); ר' \"\"שלמה נרבוני נ\"\"ע שנפטר בחברון עיר הקדש תוב\"\"ב שנת השע\"\"ד\"\" (בלק);"@he,
        "BIBLIOGRAPHIC_50929717600005171_5.txt"@he,
        "בהקדמתו עוד מציין המחבר: \"\"אמנם בטחתי בחסד אל לתקן אלו הדרושים באמרות טהורות ולהעלות אותם על ספר הישר, אשר עשיתי הנקרא בור סיד כי שמי בקרבו שמה הארכתי בשרשי מדרשי רז\"\"ל מיוסדים על אדני פז על שלשה נרות ספר נר ה', וספר נר מצוה וספר נר לרגלי"@he,
        "בכה\"\"י: \"\"נר ה'\"\" מאת \"\"כמהר\"\"ר שמואל 'ן סיד נר\"\"ו\"\""@he,
        "דרושים להספדים, לפי סדר הפרשיות, מפרשת שמות, אך נכללו גם דרושים אחדים לפרשיות."@he,
        "הספדים על פטירת: \"\"יוסף סולאל\"\" (שמות); ר' \"\"משה עטייא ... שנפטר בירושלים\"\" (2א); ר' \"\"שמואל פרנקו\"\" (בא); \"\"יעקב קשטרו\"\" (יתרו); ר' \"\"יהודה סולאל\"\" (משפטים); ר' \"\"יוסף גאדיגו\"\" (תצוה); ר' \"\"דוד סולאל\"\" (תצוה);"@he,
        "ועל כן קראתי הספר הזה נר ה' ... לרמוז על נשמת הצדיקים שנקראת נר\"\"."@he,
        "מתוך הקדמת המחבר: \"\"בהיותי באסכנדריא של מצרים אני לבדי ערב ובקר לא יבקר בין טוב לרע דברי ריבות לרבבות באופן כי לא היה לי פנאי לכתוב הדרושים שלי לולי ה' הצמיח ... תלמיד חבר החכם כה\"\"ר ישועה אזולאי נר\"\"ו אשר כתב אלו הדרושים כפי מה שהשיג ממני"@he,
        "נושא נוסף: דרשות"@he,
        "נושא נוסף: הספדים"@he,
        "נשלם בשנת ש'ל'ו'ם' [=שע\"\"ו] ...\"\" המחבר מחק והוסיף נופך בשוליים ובין השיטין."@he,
        "ר' \"\"יאודה גאביזון\"\" (מטות); ר' \"\"אברהם מונסון בשנת השע\"\"ט\"\" (דברים); ר' \"\"אלעזר מצליח\"\" (ואתחנן); ר' \"\"ברוך ן' חביב\"\" (עקב); ר' \"\"מאיר גורבאתו\"\" (ראה)."@he .

