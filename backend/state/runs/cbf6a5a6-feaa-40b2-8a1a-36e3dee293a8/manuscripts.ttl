    hm:has_material hm:Parchment ;
    hm:has_philological_perspective hm:PhilologicalView_990025903200205171 ;
    hm:has_philological_witness hm:Witness_מגלת_אסתר_in_990025903200205171 ;
    hm:has_production_event hm:Production_990025903200205171 ;
    hm:has_rights_determination hm:Rights_990025903200205171 ;
    hm:has_text_tradition hm:TextTradition_מגלת_אסתר_tradition ;
    hm:has_work hm:Work_מגלת_אסתר ;
    hm:is_composed_of hm:CU_990025903200205171_main ;
    hm:mentions_place hm:Place_Italy ;
    hm:ownership_history "ציוני בעלים בראש המגילה ועל חלק הברכות: \"\"זה שמי לעולם וזה זכרי לדור דור אלישע בכמה\"\"ר חיים רפאל אלאטינו זלה\"\"ה קניין כספי י\"\"א אדר התכ\"\"ב\"\"."^^xsd:string ;
    hm:witnesses hm:TextTradition_מגלת_אסתר_tradition ;
    rdfs:comment "BIBLIOGRAPHIC_50929717600005171_1.txt"@he,
        "במגלה היריעה הראשונה וחלק הברכות עם ציורי פרחים וחיות בצבעים. הציורים במגלה דהו במקצת. ביריעה הראשונה בציור יש סמל משפחה שדהה."@he,
        "בקלף נפרד הברכות שמברכים קודם ולאחר קריאת המגילה והפיוט \"\"קוראי מגלה הם ירננו אל אל כי מקום תהלה היתה לישראל\"\" לאברהם אבן עזרא."@he,
        "נושא נוסף: מקרא תנ\"\"ך כתובים מגלות אסתר"@he,
        "נושא נוסף: ציורים ועטורים. חיות"@he,
        "נושא נוסף: ציורים ועטורים. פרחים"@he,
        "עם תגים."@he .

