    hm:is_composed_of hm:CU_990001406710205171_main ;
    hm:mentions_place hm:Place_Jerusalem_Israel,
        hm:Place_Leeuwarden_Netherlands ;
    hm:ownership_history "ציון בעלים (דף 120ב): \"\"מעזבון המנוח יאקב בר כ\"\"ה יצחק(?) מלעוורדן זצ\"\"ל בר' פו\"\"מ כ\"\"מ אברהם בן כה' איצק לע[?]וורן יעקב די פריס זצ\"\"ל\"\" ואולי שמו הוא יעקב בן יצחק די פרימן מלעוורדן (שבהולנד)."^^xsd:string ;
    hm:witnesses hm:TextTradition_אוצרות_חיים_tradition ;
    rdfs:comment "BIBLIOGRAPHIC_50929717600005171_1.txt"@he,
        "בדף 116ב הערת המעתיק: \"\"עד כאן היה בספר אחד שלם מתחלתו ועד סופו מכתיבת יד הרב האלהי כמהה\"\"ר חיים ויטאל זלה\"\"ה\"\"."@he,
        "בדפים 117א-134ב: \"\"דרוש היכלות\"\" שער ארון וכפרת, שער אונאה, ומאמר תלת רישין השייכים לאוצרות חיים."@he,
        "בכה\"\"י: \"\"ספר אוצרות חיים ... מכתיבת יד ... חיים ויטאל זלה\"\"ה\"\""@he,
        "זהו כה\"\"י הקדום ביותר של חיבור זה."@he,
        "נושא נוסף: קבלה"@he .

