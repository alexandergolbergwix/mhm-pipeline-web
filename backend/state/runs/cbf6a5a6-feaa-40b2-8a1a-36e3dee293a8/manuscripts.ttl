    hm:mentions_place hm:Place_ʻAmrān_Yemen ;
    hm:ownership_history "בראש כתב היד שטר מכירה: \"\"יחיא ן' דאוד אלג'ברא\"\" קנה מסעיד[?] \"\"ומוסי עיאל מ\"\"ו דאוד אלדמרמרי\"\" בשנת ב'קל\"\"ז\"\" [=1826], ועליו חתום: יחיא אדהבני. העדים: \"\"יחיא ן' סאלם עראקי\"\" ו\"\"יודא ן' סעיד אלשיך\"\"."^^xsd:string ;
    hm:witnesses hm:TextTradition_משנה_תורה_ספר_מדע_אהבה_זמנים_tradition ;
    rdfs:comment "5 עמודים האחרונים מ'סדר התפלות' הנספח לסוף ספר אהבה, נעתק כאן בקיצורים ובראשי פרקים בלבד (אין בו ברכת המזון וברכות סדר ההפטרות), השווה לו כ\"\"י ירושלים NLI 446=4, שנת א'תתק\"\"ז לשטרות (1586)); סדר קריאת התורה וההפטרות (במלואו) ומעמדות (באותה כתיבה של הקולופון הסמוך מתחתיו)."@he,
        "BIBLIOGRAPHIC_50929717600005171_1.txt"@he,
        "בכה\"\"י: \"\"משנה תורה לרב רבינו משה בן הרב הדיין רבי מימון\"\""@he,
        "נושא נוסף: הלכה. פוסקים"@he,
        "נושא נוסף: כתב-יד. מכירה"@he,
        "נושא נוסף: ציורים. שער מעוטר"@he,
        "עם פרושים בשוליים."@he .

