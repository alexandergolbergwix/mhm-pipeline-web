    hm:has_digital_representation_url "http://www.bl.uk/manuscripts/FullDisplay.aspx?ref=Or_12354"^^xsd:anyURI ;
    hm:has_expression hm:Expression_unidentified_990000592310205171 ;
    hm:has_incipit "with: א\"\"א."^^xsd:string ;
    hm:has_philological_perspective hm:PhilologicalView_990000592310205171 ;
    hm:has_philological_witness hm:Witness_Unidentified_textual_content_of_MS_990000592310205171_in_990000592310205171 ;
    hm:has_production_event hm:Production_990000592310205171 ;
    hm:has_rights_determination hm:Rights_990000592310205171 ;
    hm:has_scribal_intervention hm:Intervention_990000592310205171_Marginal_gloss_type ;
    hm:has_text_tradition hm:TextTradition_Unidentified_textual_content_of_MS_990000592310205171_tradition ;
    hm:has_work hm:Work_unidentified_990000592310205171 ;
    hm:is_composed_of hm:CU_990000592310205171_01 ;
    hm:ownership_history "בדף 241א רשימת הבעלים \"\"אברהם היכיני\"\" המזכירה את נשואי הוריו בשנת \"\"שלש מאות ושבעים ושש לבריאת עולם\"\" ואת שנת כתיבת ההערה \"\"אני היום ראש שנת הת\"\"ך לבריאת עולם בן ארבעים ושנים\"\"."^^xsd:string ;
    hm:witnesses hm:TextTradition_Unidentified_textual_content_of_MS_990000592310205171_tradition ;
    rdfs:comment "BIBLIOGRAPHIC_50929717600005171_3.txt"@he,
        "F. 96b: A short list containing allusions as to the year when the messiah will come and a hint of a gematria of Shabbetai Tzvi."@he,
        "Homiletic commentaries on kabalah, yihudim (unions), and Sefer ha-Yetsirah (chapter i and the beginning of chapter ii) were appended by various hands to the manuscript."@he,
        "The beginning is missing."@he,
        "With a few marginal notes. Some begin with: א\"\"א."@he,
        "Yitzhak Luria's (ha-Ari's) writings edited into four parts. Edited by Efrayim Pantziri. The manuscript contains the first two parts: Sefer ha-Derushim and Sefer ha-Kavanot."@he,
        "בדף 96ב: רשימה קצרה ובה רמזים לשנת ביאת המשיח ורמז של גימטריא לשבתי צבי."@he,
        "במקומות אחדים בשוליים הערות. מהן פותחות: \"\"א\"\"א\"\"."@he,
        "בסוף כה\"\"י נוספו בכתיבות שונות דרושים בקבלה \"\"יחודים של מורי זלה\"\"ה\"\" וספר יצירה (פרק א ותחילת פרק ב)."@he,
        "ההתחלה חסרה."@he,
        "נושא נוסף: משיח"@he,
        "נושא נוסף: משיחיות. שבתאות"@he,
        "נושא נוסף: קבלה"@he,
        "עריכה של כתבי האר\"\"י בארבעה חלקים. העורך הוא אפרים פנצירי. כה\"\"י כולל את שני החלקים הראשונים: ספר הדרושים וספר הכונות."@he .

