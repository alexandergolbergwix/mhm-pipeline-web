    rdfs:comment "Links a binding to the manuscript it belongs to"@en .

hm:has_decoration rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:is_decoration_of ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range hm:Decoration ;
    rdfs:label "has decoration"@en ,
               "קישוט"@he ;
    rdfs:comment "Links a manuscript to its decorative elements"@en .

hm:is_decoration_of rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:has_decoration ;
    rdfs:domain hm:Decoration ;
    rdfs:range lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "is decoration of"@en ,
               "קישוט של"@he ;
    rdfs:comment "Links a decoration to the manuscript it belongs to"@en .

hm:has_marginalia rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:is_marginalia_of ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range hm:Marginalia ;
    rdfs:label "has marginalia"@en ,
               "הערות שוליים"@he ;
    rdfs:comment "Links a manuscript to its marginal annotations"@en .

hm:is_marginalia_of rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:has_marginalia ;
    rdfs:domain hm:Marginalia ;
    rdfs:range lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "is marginalia of"@en ,
               "הערות שוליים של"@he ;
    rdfs:comment "Links marginalia to the manuscript it belongs to"@en .

hm:is_translation_of rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F1_Work ;
    rdfs:range lrmoo:F1_Work ;
    rdfs:label "is translation of"@en ,
               "תרגום של"@he ;
    rdfs:comment "Links a work to the work it translates"@en .

hm:has_commentary_on rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F1_Work ;
    rdfs:range lrmoo:F1_Work ;
    rdfs:label "has commentary on"@en ,
               "פירוש על"@he ;
    rdfs:comment "Links a commentary work to the work it comments on"@en .

hm:has_vocalization rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F2_Expression ;
    rdfs:range cidoc-crm:E55_Type ;
    rdfs:label "has vocalization"@en ,
               "ניקוד"@he ;
    rdfs:comment "Type of vowel pointing (Tiberian, Babylonian, Palestinian, none)"@en .

hm:has_cantillation rdf:type owl:ObjectProperty ;
