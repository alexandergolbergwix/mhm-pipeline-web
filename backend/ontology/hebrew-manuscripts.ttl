    rdfs:comment "Links an expression to its cantillation/trope type"@en .

hm:copied_from rdf:type owl:ObjectProperty , owl:AsymmetricProperty ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "copied from"@en ,
               "הועתק מ"@he ;
    rdfs:comment "Links a manuscript to its exemplar"@en .

hm:is_scribe_mentioned_in rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:mentions_scribe ;
    rdfs:domain cidoc-crm:E21_Person ;
    rdfs:range hm:Colophon ;
