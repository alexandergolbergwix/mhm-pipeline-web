### NEW Properties addressing reviewer feedback (v1.2)

## Certainty/Confidence Properties

hm:has_certainty rdf:type owl:ObjectProperty ;
    rdfs:range hm:CertaintyLevel ;
    rdfs:label "has certainty"@en ,
               "רמת וודאות"@he ;
    rdfs:comment "Indicates the degree of certainty for any attribution or identification"@en .

hm:attribution_source rdf:type owl:ObjectProperty ;
    rdfs:range hm:AttributionSource ;
    rdfs:label "attribution source"@en ,
               "מקור הייחוס"@he ;
    rdfs:comment "Source of an attribution (human expert, AI system, catalog)"@en .

hm:attributed_by rdf:type owl:ObjectProperty ;
    rdfs:range cidoc-crm:E39_Actor ;
    rdfs:label "attributed by"@en ,
               "יוחס על ידי"@he ;
    rdfs:comment "Person or system that made the attribution"@en .

## Variant and Partial Identification Properties

hm:is_variant_of rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F1_Work ;
    rdfs:range lrmoo:F1_Work ;
    rdfs:label "is variant of"@en ,
               "גרסה של"@he ;
    rdfs:comment "Links a work that is a variant, adaptation, or abridgment of another work"@en .

hm:possibly_realises rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F2_Expression ;
    rdfs:range lrmoo:F1_Work ;
    rdfs:label "possibly realises"@en ,
               "אולי ממומש של"@he ;
    rdfs:comment "Indicates uncertain identification of an expression with a known work"@en .

hm:is_abridgment_of rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf hm:is_variant_of ;
    rdfs:domain lrmoo:F1_Work ;
    rdfs:range lrmoo:F1_Work ;
    rdfs:label "is abridgment of"@en ,
               "קיצור של"@he ;
    rdfs:comment "Links a work to the work it abbreviates"@en .

hm:is_adaptation_of rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf hm:is_variant_of ;
    rdfs:domain lrmoo:F1_Work ;
    rdfs:range lrmoo:F1_Work ;
    rdfs:label "is adaptation of"@en ,
               "עיבוד של"@he ;
    rdfs:comment "Links a work to the work it adapts"@en .

hm:parallels rdf:type owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain lrmoo:F1_Work ;
    rdfs:range lrmoo:F1_Work ;
    rdfs:label "parallels"@en ,
               "מקביל ל"@he ;
    rdfs:comment "Links works that share content but relationship is unclear"@en .

## Textual Overlap Properties

hm:has_textual_overlap_with rdf:type owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain hm:Paleographical_Unit ;
    rdfs:range hm:Paleographical_Unit ;
    rdfs:label "has textual overlap with"@en ,
               "חופף טקסטואלית ל"@he ;
    rdfs:comment "Two scribal units that copy overlapping portions of the same text"@en .

hm:duplicates_part_of rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F2_Expression ;
    rdfs:range lrmoo:F2_Expression ;
    rdfs:label "duplicates part of"@en ,
               "מכפיל חלק מ"@he ;
    rdfs:comment "Expression that duplicates a portion of another expression in same MS"@en .

## Multi-Volume and Anthology Structure Properties

hm:is_volume_of rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    owl:inverseOf hm:has_volume ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range hm:MultiVolumeSet ;
    rdfs:label "is volume of"@en ,
               "כרך של"@he ;
    rdfs:comment "Links a physical volume to the multi-volume set it belongs to. Declared Functional: each volume belongs to at most one set. If a volume is asserted in two sets the reasoner will infer those sets are identical."@en .

hm:has_volume rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:is_volume_of ;
    rdfs:domain hm:MultiVolumeSet ;
    rdfs:range lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "has volume"@en ,
               "כולל כרך"@he ;
    rdfs:comment "Links a multi-volume set to one of its constituent volumes"@en .

hm:former_owner rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:was_former_owner_of ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range cidoc-crm:E21_Person ;
    rdfs:label "former owner"@en ,
               "בעלים קודם"@he ;
    rdfs:comment "Previous owner(s) of the manuscript (e.g. from MARC 700 with owner role)"@en .

hm:was_former_owner_of rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:former_owner ;
    rdfs:domain cidoc-crm:E21_Person ;
    rdfs:range lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "was former owner of"@en ,
               "היה בעלים קודם של"@he ;
    rdfs:comment "Links a person to manuscripts they formerly owned"@en .

hm:is_part_of_host rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:hosts_part ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "is part of host"@en ,
               "חלק מפריט מארח"@he ;
    rdfs:comment "Links to host item when this manuscript is part of a larger item (MARC 773)"@en .

hm:hosts_part rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:is_part_of_host ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "hosts part"@en ,
               "מארח חלק"@he ;
    rdfs:comment "Links a host item to manuscripts that are part of it"@en .

hm:has_anthology_position rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F2_Expression ;
    rdfs:range hm:AnthologyPosition ;
    rdfs:label "has anthology position"@en ,
               "מיקום באנתולוגיה"@he ;
    rdfs:comment "Position and ordering of text within an anthology manuscript. Use Expression -> has_anthology_position -> AnthologyPosition -> anthology_order -> integer."@en .

## Scribal Layer and Intervention Properties

hm:has_scribal_intervention rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:is_intervention_in ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range hm:ScribalIntervention ;
    rdfs:label "has scribal intervention"@en ,
               "התערבות סופר"@he ;
    rdfs:comment "Corrections, additions, or modifications by scribes"@en .

hm:is_intervention_in rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:has_scribal_intervention ;
    rdfs:domain hm:ScribalIntervention ;
    rdfs:range lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "is intervention in"@en ,
               "התערבות ב"@he ;
    rdfs:comment "Links a scribal intervention to the manuscript it occurs in"@en .

hm:intervention_location rdf:type owl:ObjectProperty ;
    rdfs:domain hm:ScribalIntervention ;
    rdfs:range hm:TextLocation ;
    rdfs:label "intervention location"@en ,
               "מיקום ההתערבות"@he ;
    rdfs:comment "Links a scribal intervention to its location in the manuscript"@en .

hm:intervention_by rdf:type owl:ObjectProperty ;
    rdfs:domain hm:ScribalIntervention ;
    rdfs:range cidoc-crm:E21_Person ;
    rdfs:label "intervention by"@en ,
               "התערבות על ידי"@he ;
    rdfs:comment "Links a scribal intervention to the person who made it"@en .

## Lost Manuscript Properties

hm:is_copy_of_lost rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:known_through ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range hm:LostManuscript ;
    rdfs:label "is copy of lost manuscript"@en ,
               "עותק של כתב יד אבוד"@he ;
    rdfs:comment "Links an extant manuscript to the lost exemplar it is a copy of"@en .

hm:known_through rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:is_copy_of_lost ;
    rdfs:domain hm:LostManuscript ;
    rdfs:range lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "known through"@en ,
               "ידוע דרך"@he ;
    rdfs:comment "Extant manuscript through which a lost manuscript is known"@en .

### NEW Properties for v1.3 - Text Tradition Layer (Hybrid Philological Approach)

## Text Tradition Properties

