    owl:members ( hm:FullPageIllumination hm:InitialLetters hm:MarginalDecoration hm:CarpetPage hm:Micrography ) .

[] a owl:AllDifferent ;
    owl:members ( hm:TiberianVocalization hm:BabylonianVocalization hm:PalestinianVocalization hm:NoVocalization ) .

[] a owl:AllDifferent ;
    owl:members ( hm:OriginalBinding hm:Rebinding hm:ConservationBinding hm:Unbound ) .

[] a owl:AllDifferent ;
    owl:members ( hm:GregorianYear hm:HebrewYear hm:FullDate hm:UnstructuredDate ) .

[] a owl:AllDifferent ;
    owl:members ( hm:Certain hm:Probable hm:Possible hm:Uncertain ) .

[] a owl:AllDifferent ;
    owl:members ( hm:ExpertAttribution hm:AIAttribution hm:CatalogAttribution hm:ColophonAttribution hm:PaleographicAttribution ) .

[] a owl:AllDifferent ;
    owl:members ( hm:Scribe_role hm:Author_role hm:Illuminator_role hm:Commentator_role hm:Translator_role hm:Owner_role ) .

[] a owl:AllDifferent ;
    owl:members ( hm:Bible_Subject hm:Talmud_Subject hm:Midrash_Subject hm:Halakha_Subject hm:Kabbalah_Subject hm:Philosophy_Subject hm:Liturgy_Subject hm:Poetry_Subject hm:Medicine_Subject hm:Science_Subject ) .

[] a owl:AllDifferent ;
    owl:members ( hm:CoreUnit_status hm:LaterAddition_status hm:BinderAddition_status hm:UnrelatedFragment_status hm:ProtectiveLeaf_status ) .

[] a owl:AllDifferent ;
    owl:members ( hm:Bible_hierarchy hm:Mishnah_hierarchy hm:Talmud_Bavli_hierarchy hm:Talmud_Yerushalmi_hierarchy hm:Mishneh_Torah_hierarchy hm:Shulchan_Aruch_hierarchy hm:Zohar_hierarchy hm:Midrash_hierarchy ) .

[] a owl:AllDifferent ;
    owl:members ( hm:DirectObservation hm:ScholarlyInterpretation hm:ComputationalDerivation hm:CatalogInherited hm:TraditionalAttribution ) .

[] a owl:AllDifferent ;
    owl:members ( hm:PhysicalMeasurement hm:ColophonContent hm:MaterialObservation hm:DateAttribution hm:AuthorshipAttribution hm:ScribeIdentification hm:PlaceAttribution hm:WorkIdentification hm:TextualRelationship ) .

[] a owl:AllDifferent ;
    owl:members ( hm:PaleographicAnalysis hm:CodicologicalAnalysis hm:LinguisticAnalysis hm:HistoricalContextAnalysis hm:ComparativeTextualAnalysis hm:AIBasedAnalysis hm:RadiocarbonDating hm:WatermarkAnalysis ) .

