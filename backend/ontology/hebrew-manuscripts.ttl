#################################################################
#    v1.4 - DUAL PARADIGM SUPPORT (Expert Feedback Phase 1)
#    Resolves philosophical tension between bibliographic-practical
#    and new philological approaches
#################################################################

### Dual Paradigm Object Properties

hm:has_cataloging_perspective rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range hm:CatalogingView ;
    rdfs:label "has cataloging perspective"@en ,
               "בעל פרספקטיבה קטלוגית"@he ;
    rdfs:comment "Links manuscript to its bibliographic/cataloging view following LRM Work-Expression model"@en .

hm:has_philological_perspective rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range hm:PhilologicalView ;
    rdfs:label "has philological perspective"@en ,
               "בעל פרספקטיבה פילולוגית"@he ;
    rdfs:comment "Links manuscript to its philological view treating it as unique cultural event"@en .

hm:paradigm_bridge rdf:type owl:ObjectProperty ;
    rdfs:domain hm:ParadigmBridge ;
    rdfs:range owl:Thing ;
    rdfs:label "paradigm bridge"@en ,
               "גשר פרדיגמטי"@he ;
    rdfs:comment "Generic bridging property connecting entities across paradigms"@en .

hm:has_linked_work rdf:type owl:ObjectProperty ;
    rdfs:domain hm:ParadigmBridge ;
    rdfs:range lrmoo:F1_Work ;
    rdfs:label "has linked work"@en ,
               "יצירה מקושרת"@he ;
    rdfs:comment "ParadigmBridge links to the Work (bibliographic side)"@en .

hm:has_linked_tradition rdf:type owl:ObjectProperty ;
    rdfs:domain hm:ParadigmBridge ;
    rdfs:range hm:TextTradition ;
    rdfs:label "has linked tradition"@en ,
               "מסורת מקושרת"@he ;
    rdfs:comment "ParadigmBridge links to the TextTradition (philological side)"@en .


hm:view_type rdf:type owl:ObjectProperty ;
    rdfs:domain hm:ManuscriptView ;
    rdfs:range hm:ViewType ;
    rdfs:label "view type"@en ,
               "סוג תצוגה"@he ;
    rdfs:comment "Type of manuscript view (cataloging, philological, etc.)"@en .

hm:cataloging_work rdf:type owl:ObjectProperty ;
    rdfs:domain hm:CatalogingView ;
    rdfs:range lrmoo:F1_Work ;
    rdfs:label "cataloging work"@en ,
               "יצירה לקטלוג"@he ;
    rdfs:comment "The Work entity used for cataloging purposes"@en .

hm:cataloging_expression rdf:type owl:ObjectProperty ;
    rdfs:domain hm:CatalogingView ;
    rdfs:range lrmoo:F2_Expression ;
    rdfs:label "cataloging expression"@en ,
               "ביטוי לקטלוג"@he ;
    rdfs:comment "The Expression entity used for cataloging purposes"@en .

hm:philological_tradition rdf:type owl:ObjectProperty ;
    rdfs:domain hm:PhilologicalView ;
    rdfs:range hm:TextTradition ;
    rdfs:label "philological tradition"@en ,
               "מסורת פילולוגית"@he ;
    rdfs:comment "The TextTradition this manuscript witnesses in philological view"@en .

hm:philological_witness rdf:type owl:ObjectProperty ;
    rdfs:domain hm:PhilologicalView ;
    rdfs:range hm:TransmissionWitness ;
    rdfs:label "philological witness"@en ,
               "עד פילולוגי"@he ;
    rdfs:comment "The TransmissionWitness entity representing MS as cultural event"@en .

hm:has_philological_witness rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range hm:TransmissionWitness ;
    rdfs:label "has philological witness"@en ,
               "בעל עד פילולוגי"@he ;
    rdfs:comment "Direct link from manuscript to its transmission witness (shortcut property)"@en .

hm:is_paradigm_compatible rdf:type owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain hm:ManuscriptView ;
    rdfs:range hm:ManuscriptView ;
    rdfs:label "is paradigm compatible"@en ,
               "תואם פרדיגמה"@he ;
    rdfs:comment "Indicates two views can coexist without conflict"@en .

### Dual Paradigm Datatype Properties

hm:paradigm_note rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:ManuscriptView ;
    rdfs:range xsd:string ;
    rdfs:label "paradigm note"@en ,
               "הערת פרדיגמה"@he ;
    rdfs:comment "Explanation of how this paradigm applies to the manuscript"@en .

hm:is_primary_paradigm rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:ManuscriptView ;
    rdfs:range xsd:boolean ;
    rdfs:label "is primary paradigm"@en ,
               "פרדיגמה עיקרית"@he ;
    rdfs:comment "Whether this is the primary/preferred paradigm for this MS"@en .

hm:paradigm_justification rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:ParadigmBridge ;
    rdfs:range xsd:string ;
    rdfs:label "paradigm justification"@en ,
               "הצדקת גשר פרדיגמטי"@he ;
    rdfs:comment "Scholarly justification for bridging Work and TextTradition"@en .

### Dual Paradigm Classes

hm:ManuscriptView rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E28_Conceptual_Object ;
    rdfs:label "Manuscript View"@en ,
               "תצוגת כתב יד"@he ;
    rdfs:comment "Abstract class for different paradigmatic views of a manuscript"@en .

hm:CatalogingView rdf:type owl:Class ;
    rdfs:subClassOf hm:ManuscriptView ;
    rdfs:label "Cataloging View"@en ,
               "תצוגה קטלוגית"@he ;
    rdfs:comment "Bibliographic-practical view following LRM Work-Expression-Manifestation model. Suitable for Wikidata integration and library cataloging."@en .

hm:PhilologicalView rdf:type owl:Class ;
    rdfs:subClassOf hm:ManuscriptView ;
    rdfs:label "Philological View"@en ,
               "תצוגה פילולוגית"@he ;
    rdfs:comment "New philological view treating each MS as unique cultural event, emphasizing textual fluidity. Rejects unified 'Work' concept."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( hm:CatalogingView hm:PhilologicalView ) .

hm:ParadigmBridge rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E28_Conceptual_Object ;
    rdfs:label "Paradigm Bridge"@en ,
               "גשר פרדיגמות"@he ;
    rdfs:comment "Entity that explicitly links Work (bibliographic) to TextTradition (philological) when both views apply to same content"@en .

hm:ViewType rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "View Type"@en ,
               "סוג תצוגה"@he ;
    rdfs:comment "Type classification for manuscript views"@en .

### Dual Paradigm Controlled Vocabulary

hm:BibliographicParadigm rdf:type owl:NamedIndividual , hm:ViewType ;
    rdfs:label "Bibliographic Paradigm"@en ,
               "פרדיגמה ביבליוגרפית"@he ;
    rdfs:comment "LRM-based cataloging approach with unified Work concept"@en .

hm:PhilologicalParadigm rdf:type owl:NamedIndividual , hm:ViewType ;
    rdfs:label "Philological Paradigm"@en ,
               "פרדיגמה פילולוגית"@he ;
    rdfs:comment "New philology approach emphasizing textual fluidity and cultural events"@en .

hm:HybridParadigm rdf:type owl:NamedIndividual , hm:ViewType ;
    rdfs:label "Hybrid Paradigm"@en ,
               "פרדיגמה היברידית"@he ;
    rdfs:comment "Both bibliographic and philological views apply with explicit bridging"@en .

#################################################################
#    v1.4 - NESTED CODICOLOGICAL STRUCTURE (Expert Feedback Phase 2)
#    Enables recursive CU composition for complex manuscripts
#    Addresses Eliezer's concern about rigid hierarchy
#################################################################

### Nested CU Object Properties

hm:has_sub_unit rdf:type owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:domain hm:Codicological_Unit ;
    rdfs:range hm:Codicological_Unit ;
    rdfs:label "has sub-unit"@en ,
               "מכיל תת-יחידה"@he ;
    rdfs:comment "Links a codicological unit to its nested sub-units. Transitive property allowing arbitrary nesting depth."@en .

hm:is_sub_unit_of rdf:type owl:ObjectProperty , owl:TransitiveProperty ;
    owl:inverseOf hm:has_sub_unit ;
    rdfs:domain hm:Codicological_Unit ;
    rdfs:range hm:Codicological_Unit ;
    rdfs:label "is sub-unit of"@en ,
               "תת-יחידה של"@he ;
    rdfs:comment "Links a codicological unit to its parent unit in the hierarchy"@en .

hm:has_parent_unit rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf hm:is_sub_unit_of ;
    rdfs:domain hm:Codicological_Unit ;
    rdfs:range hm:Codicological_Unit ;
    rdfs:label "has parent unit"@en ,
               "יחידת אב"@he ;
    rdfs:comment "Direct parent codicological unit only (non-transitive); implies is_sub_unit_of."@en .

hm:has_hierarchy rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range hm:CodicologicalHierarchy ;
    rdfs:label "has hierarchy"@en ,
               "בעל היררכיה"@he ;
    rdfs:comment "Links manuscript to its codicological hierarchy structure"@en .

hm:hierarchy_root rdf:type owl:ObjectProperty ;
    rdfs:domain hm:CodicologicalHierarchy ;
    rdfs:range hm:Codicological_Unit ;
    rdfs:label "hierarchy root"@en ,
               "שורש היררכיה"@he ;
    rdfs:comment "The top-level codicological unit(s) in the hierarchy"@en .

hm:hierarchy_type rdf:type owl:ObjectProperty ;
    rdfs:domain hm:CodicologicalHierarchy ;
    rdfs:range hm:HierarchyType ;
    rdfs:label "hierarchy type"@en ,
               "סוג היררכיה"@he ;
    rdfs:comment "Type of codicological hierarchy (simple, nested, etc.)"@en .

hm:adjacent_unit rdf:type owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain hm:Codicological_Unit ;
    rdfs:range hm:Codicological_Unit ;
    rdfs:label "adjacent unit"@en ,
               "יחידה סמוכה"@he ;
    rdfs:comment "Units that are physically adjacent at the same hierarchy level"@en .

hm:precedes_unit rdf:type owl:ObjectProperty , owl:AsymmetricProperty , owl:IrreflexiveProperty ;
    rdfs:domain hm:Codicological_Unit ;
    rdfs:range hm:Codicological_Unit ;
    rdfs:label "precedes unit"@en ,
               "קודם ליחידה"@he ;
    rdfs:comment "This unit comes before another in physical sequence"@en .

hm:follows_unit rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:precedes_unit ;
    rdfs:domain hm:Codicological_Unit ;
    rdfs:range hm:Codicological_Unit ;
    rdfs:label "follows unit"@en ,
               "עוקב ליחידה"@he ;
    rdfs:comment "Links a codicological unit to the unit that follows it in order"@en .

### Nested CU Datatype Properties

hm:nesting_level rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:Codicological_Unit ;
    rdfs:range xsd:integer ;
    rdfs:label "nesting level"@en ,
               "רמת קינון"@he ;
    rdfs:comment "Depth in the codicological hierarchy (0 = root/top level)"@en .

hm:is_atomic_unit rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:Codicological_Unit ;
    rdfs:range xsd:boolean ;
    rdfs:label "is atomic unit"@en ,
               "יחידה אטומית"@he ;
    rdfs:comment "True if this is a leaf node with no sub-units"@en .

hm:unit_sequence rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:Codicological_Unit ;
    rdfs:range xsd:integer ;
    rdfs:label "unit sequence"@en ,
               "מספר סידורי"@he ;
    rdfs:comment "Order position among sibling units"@en .

hm:hierarchy_description rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:CodicologicalHierarchy ;
    rdfs:range xsd:string ;
    rdfs:label "hierarchy description"@en ,
               "תיאור היררכיה"@he ;
    rdfs:comment "Textual description of the codicological structure complexity"@en .

hm:max_nesting_depth rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:CodicologicalHierarchy ;
    rdfs:range xsd:integer ;
    rdfs:label "max nesting depth"@en ,
               "עומק קינון מקסימלי"@he ;
    rdfs:comment "Maximum depth of unit nesting in this manuscript"@en .

### Nested CU Classes

hm:CodicologicalHierarchy rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E28_Conceptual_Object ;
    rdfs:label "Codicological Hierarchy"@en ,
               "היררכיה קודיקולוגית"@he ;
    rdfs:comment "Describes the overall structure of nested codicological units in a manuscript. Manages complex compositions like MTM (Multiple Text Manuscripts)."@en .

hm:CompositeCodicologicalUnit rdf:type owl:Class ;
    rdfs:subClassOf hm:Codicological_Unit ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( hm:Codicological_Unit
            [ a owl:Restriction ;
              owl:onProperty hm:has_sub_unit ;
              owl:someValuesFrom hm:Codicological_Unit ] ) ] ;
    rdfs:label "Composite Codicological Unit"@en ,
               "יחידה קודיקולוגית מורכבת"@he ;
    rdfs:comment "A codicological unit that contains sub-units (not atomic)"@en .

hm:AtomicCodicologicalUnit rdf:type owl:Class ;
    rdfs:subClassOf hm:Codicological_Unit ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( hm:Codicological_Unit
            [ a owl:Class ;
              owl:complementOf [ a owl:Restriction ;
                owl:onProperty hm:has_sub_unit ;
                owl:someValuesFrom hm:Codicological_Unit ] ] ) ] ;
    rdfs:label "Atomic Codicological Unit"@en ,
               "יחידה קודיקולוגית אטומית"@he ;
    rdfs:comment "A leaf-level codicological unit with no sub-divisions"@en .

hm:CompositeCodicologicalUnit owl:disjointWith hm:AtomicCodicologicalUnit .

hm:HierarchyType rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Hierarchy Type"@en ,
               "סוג היררכיה"@he ;
    rdfs:comment "Classification of codicological hierarchy complexity"@en .

### Nested CU Controlled Vocabulary

hm:SimpleHierarchy rdf:type owl:NamedIndividual , hm:HierarchyType ;
    rdfs:label "Simple Hierarchy"@en ,
               "היררכיה פשוטה"@he ;
    rdfs:comment "Single level: manuscript contains CUs directly"@en .

hm:NestedHierarchy rdf:type owl:NamedIndividual , hm:HierarchyType ;
    rdfs:label "Nested Hierarchy"@en ,
               "היררכיה מקוננת"@he ;
    rdfs:comment "Multiple levels: CUs contain sub-CUs"@en .

hm:ComplexHierarchy rdf:type owl:NamedIndividual , hm:HierarchyType ;
    rdfs:label "Complex Hierarchy"@en ,
               "היררכיה מורכבת"@he ;
    rdfs:comment "Deeply nested with irregular structure (MTM, Sammelband)"@en .

hm:FragmentaryHierarchy rdf:type owl:NamedIndividual , hm:HierarchyType ;
    rdfs:label "Fragmentary Hierarchy"@en ,
               "היררכיה קטעית"@he ;
    rdfs:comment "Incomplete structure due to loss or damage"@en .

#################################################################
#    v1.4 - EPISTEMOLOGICAL FRAMEWORK (Expert Feedback Phase 3)
#    Systematic distinction between facts vs. scholarly interpretations
#    Addresses Moshe's concern about data classification
#################################################################

### Epistemological Object Properties

hm:has_epistemological_status rdf:type owl:ObjectProperty ;
    rdfs:range hm:EpistemologicalStatus ;
    rdfs:label "has epistemological status"@en ,
               "סטטוס אפיסטמולוגי"@he ;
    rdfs:comment "Classifies any data point as fact, interpretation, or derived data"@en .

hm:has_evidence_chain rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:is_chain_for ;
    rdfs:range hm:EvidenceChain ;
    rdfs:label "has evidence chain"@en ,
               "שרשרת ראיות"@he ;
    rdfs:comment "Links an assertion to its supporting evidence chain"@en .

hm:is_chain_for rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:has_evidence_chain ;
    rdfs:domain hm:EvidenceChain ;
    rdfs:range owl:Thing ;
    rdfs:label "is chain for"@en ,
               "שרשרת עבור"@he .

hm:evidence_step rdf:type owl:ObjectProperty ;
    rdfs:domain hm:EvidenceChain ;
    rdfs:range hm:EvidenceStep ;
    rdfs:label "evidence step"@en ,
               "צעד ראייתי"@he ;
    rdfs:comment "An individual step in the evidence chain"@en .

hm:evidence_source rdf:type owl:ObjectProperty ;
    rdfs:domain hm:EvidenceStep ;
    rdfs:range cidoc-crm:E73_Information_Object ;
    rdfs:label "evidence source"@en ,
               "מקור ראיה"@he ;
    rdfs:comment "The source document or data supporting this step"@en .

hm:evidence_agent rdf:type owl:ObjectProperty ;
    rdfs:domain hm:EvidenceStep ;
    rdfs:range cidoc-crm:E39_Actor ;
    rdfs:label "evidence agent"@en ,
               "סוכן ראייתי"@he ;
    rdfs:comment "Person or system that provided/generated this evidence"@en .

hm:derives_from rdf:type owl:ObjectProperty , owl:AsymmetricProperty , owl:IrreflexiveProperty , owl:TransitiveProperty ;
    rdfs:domain hm:EvidenceStep ;
    rdfs:range hm:EvidenceStep ;
    rdfs:label "derives from"@en ,
               "נגזר מ"@he ;
    rdfs:comment "Links evidence steps in derivation chain"@en .

hm:supports_assertion rdf:type owl:ObjectProperty ;
    rdfs:domain hm:EvidenceChain ;
    rdfs:range owl:Thing ;
    rdfs:label "supports assertion"@en ,
               "תומך בטענה"@he ;
    rdfs:comment "The assertion this evidence chain supports"@en .

hm:contradicts_assertion rdf:type owl:ObjectProperty ;
    rdfs:domain hm:EvidenceChain ;
    rdfs:range owl:Thing ;
    rdfs:label "contradicts assertion"@en ,
               "סותר טענה"@he ;
    rdfs:comment "An assertion this evidence contradicts"@en .

hm:data_category rdf:type owl:ObjectProperty ;
    rdfs:range hm:DataCategory ;
    rdfs:label "data category"@en ,
               "קטגוריית נתונים"@he ;
    rdfs:comment "Classification of data type for epistemological purposes"@en .

hm:interpretation_method rdf:type owl:ObjectProperty ;
    rdfs:domain hm:EvidenceStep ;
    rdfs:range hm:InterpretationMethod ;
    rdfs:label "interpretation method"@en ,
               "שיטת פרשנות"@he ;
    rdfs:comment "The method used to derive this interpretation"@en .

hm:competing_interpretation rdf:type owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain hm:EvidenceStep ;
    rdfs:range hm:EvidenceStep ;
    rdfs:label "competing interpretation"@en ,
               "פרשנות מתחרה"@he ;
    rdfs:comment "Links alternative interpretations of the same evidence"@en .

### Epistemological Datatype Properties

hm:is_factual rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "is factual"@en ,
               "האם עובדתי"@he ;
    rdfs:comment "Quick filter: true if data is directly observable fact, false if interpretation"@en .

hm:interpretation_date rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:EvidenceStep ;
    rdfs:range xsd:date ;
    rdfs:label "interpretation date"@en ,
               "תאריך פרשנות"@he ;
    rdfs:comment "When this interpretation was made"@en .

hm:evidence_strength rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:EvidenceStep ;
    rdfs:range xsd:decimal ;
    rdfs:label "evidence strength"@en ,
               "עוצמת ראיה"@he ;
    rdfs:comment "Numeric strength of this evidence (0-1 scale)"@en .

hm:reasoning_text rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:EvidenceStep ;
    rdfs:range xsd:string ;
    rdfs:label "reasoning text"@en ,
               "טקסט נימוק"@he ;
    rdfs:comment "Textual explanation of the reasoning behind this step"@en .

hm:methodology_reference rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:EvidenceStep ;
    rdfs:range xsd:string ;
    rdfs:label "methodology reference"@en ,
               "הפניה למתודולוגיה"@he ;
    rdfs:comment "Citation to scholarly methodology used"@en .

hm:consensus_level rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:EvidenceStep ;
    rdfs:range xsd:string ;
    rdfs:label "consensus level"@en ,
               "רמת קונצנזוס"@he ;
    rdfs:comment "Degree of scholarly consensus (free text). Prefer has_consensus_level_type for controlled values."@en .

hm:has_consensus_level_type rdf:type owl:ObjectProperty ;
    rdfs:domain hm:EvidenceStep ;
    rdfs:range hm:ConsensusLevelType ;
    rdfs:label "has consensus level type"@en ,
               "סוג רמת קונצנזוס"@he ;
    rdfs:comment "Controlled vocabulary for degree of scholarly consensus"@en .

hm:supersedes_interpretation rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:EvidenceStep ;
    rdfs:range xsd:boolean ;
    rdfs:label "supersedes interpretation"@en ,
               "מחליף פרשנות קודמת"@he ;
    rdfs:comment "True if this interpretation supersedes a previous one"@en .

### Epistemological Classes

hm:EpistemologicalStatus rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Epistemological Status"@en ,
               "סטטוס אפיסטמולוגי"@he ;
    rdfs:comment "Classification of data according to its epistemological nature: direct observation, scholarly interpretation, or computational derivation"@en .

hm:EvidenceChain rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E28_Conceptual_Object ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty hm:evidence_step ;
        owl:minCardinality 1 ] ;
    rdfs:label "Evidence Chain"@en ,
               "שרשרת ראיות"@he ;
    rdfs:comment "A chain of evidence steps supporting an assertion, documenting the reasoning path from raw data to conclusion"@en .

hm:EvidenceStep rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E7_Activity ;
    rdfs:label "Evidence Step"@en ,
               "צעד ראייתי"@he ;
    rdfs:comment "A single step in an evidence chain, representing one observation, interpretation, or derivation"@en .

hm:DirectObservationStep rdf:type owl:Class ;
    rdfs:subClassOf hm:EvidenceStep ;
    rdfs:label "Direct Observation Step"@en ,
               "צעד תצפית ישירה"@he ;
    rdfs:comment "Evidence step based on direct observation of manuscript (measurements, colophon text, physical features)"@en .

hm:InterpretationStep rdf:type owl:Class ;
    rdfs:subClassOf hm:EvidenceStep ;
    rdfs:label "Interpretation Step"@en ,
               "צעד פרשנות"@he ;
    rdfs:comment "Evidence step involving scholarly interpretation (dating, attribution, identification)"@en .

hm:ComputationalStep rdf:type owl:Class ;
    rdfs:subClassOf hm:EvidenceStep ;
    rdfs:label "Computational Step"@en ,
               "צעד חישובי"@he ;
    rdfs:comment "Evidence step derived through computational analysis (AI, statistical methods)"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( hm:DirectObservationStep hm:InterpretationStep hm:ComputationalStep ) .

hm:DataCategory rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Data Category"@en ,
               "קטגוריית נתונים"@he ;
    rdfs:comment "Classification of manuscript data by epistemological origin"@en .

hm:InterpretationMethod rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Interpretation Method"@en ,
               "שיטת פרשנות"@he ;
    rdfs:comment "Scholarly method used for interpretation"@en .

### Epistemological Status Instances

hm:DirectObservation rdf:type owl:NamedIndividual , hm:EpistemologicalStatus ;
    rdfs:label "Direct Observation"@en ,
               "תצפית ישירה"@he ;
    rdfs:comment "Data derived from direct observation of the manuscript - unambiguous facts"@en .

hm:ScholarlyInterpretation rdf:type owl:NamedIndividual , hm:EpistemologicalStatus ;
    rdfs:label "Scholarly Interpretation"@en ,
               "פרשנות חוקר"@he ;
    rdfs:comment "Data resulting from scholarly decision/interpretation - requires expert judgment"@en .

hm:ComputationalDerivation rdf:type owl:NamedIndividual , hm:EpistemologicalStatus ;
    rdfs:label "Computational Derivation"@en ,
               "גזירה חישובית"@he ;
    rdfs:comment "Data derived through computational/AI methods (e.g., MIDRASH system)"@en .

hm:CatalogInherited rdf:type owl:NamedIndividual , hm:EpistemologicalStatus ;
    rdfs:label "Catalog Inherited"@en ,
               "ירושה מקטלוג"@he ;
    rdfs:comment "Data inherited from existing catalog without independent verification"@en .

hm:TraditionalAttribution rdf:type owl:NamedIndividual , hm:EpistemologicalStatus ;
    rdfs:label "Traditional Attribution"@en ,
               "ייחוס מסורתי"@he ;
    rdfs:comment "Long-standing attribution without modern scholarly verification"@en .

### Data Category Instances

hm:PhysicalMeasurement rdf:type owl:NamedIndividual , hm:DataCategory ;
    rdfs:label "Physical Measurement"@en ,
               "מדידה פיסית"@he ;
    rdfs:comment "Directly measurable physical properties (size, folios, lines)"@en .

hm:ColophonContent rdf:type owl:NamedIndividual , hm:DataCategory ;
    rdfs:label "Colophon Content"@en ,
               "תוכן קולופון"@he ;
    rdfs:comment "Text directly quoted from colophon"@en .

hm:MaterialObservation rdf:type owl:NamedIndividual , hm:DataCategory ;
    rdfs:label "Material Observation"@en ,
               "תצפית חומר"@he ;
    rdfs:comment "Observable material properties (parchment, paper, ink)"@en .

hm:DateAttribution rdf:type owl:NamedIndividual , hm:DataCategory ;
    rdfs:label "Date Attribution"@en ,
               "ייחוס תאריך"@he ;
    rdfs:comment "Dating of manuscript - usually requires interpretation"@en .

hm:AuthorshipAttribution rdf:type owl:NamedIndividual , hm:DataCategory ;
    rdfs:label "Authorship Attribution"@en ,
               "ייחוס מחברות"@he ;
    rdfs:comment "Attribution of authorship - often requires interpretation"@en .

hm:ScribeIdentification rdf:type owl:NamedIndividual , hm:DataCategory ;
    rdfs:label "Scribe Identification"@en ,
               "זיהוי סופר"@he ;
    rdfs:comment "Identification of scribe - requires paleographic interpretation"@en .

hm:PlaceAttribution rdf:type owl:NamedIndividual , hm:DataCategory ;
    rdfs:label "Place Attribution"@en ,
               "ייחוס מקום"@he ;
    rdfs:comment "Geographic origin attribution"@en .

hm:WorkIdentification rdf:type owl:NamedIndividual , hm:DataCategory ;
    rdfs:label "Work Identification"@en ,
               "זיהוי יצירה"@he ;
    rdfs:comment "Identification of which Work the text represents"@en .

hm:TextualRelationship rdf:type owl:NamedIndividual , hm:DataCategory ;
    rdfs:label "Textual Relationship"@en ,
               "יחס טקסטואלי"@he ;
    rdfs:comment "Relationship between texts/manuscripts - derived through analysis"@en .

### Interpretation Method Instances

hm:PaleographicAnalysis rdf:type owl:NamedIndividual , hm:InterpretationMethod ;
    rdfs:label "Paleographic Analysis"@en ,
               "ניתוח פליאוגרפי"@he ;
    rdfs:comment "Analysis of script characteristics"@en .

hm:CodicologicalAnalysis rdf:type owl:NamedIndividual , hm:InterpretationMethod ;
    rdfs:label "Codicological Analysis"@en ,
               "ניתוח קודיקולוגי"@he ;
    rdfs:comment "Analysis of physical manuscript structure"@en .

hm:LinguisticAnalysis rdf:type owl:NamedIndividual , hm:InterpretationMethod ;
    rdfs:label "Linguistic Analysis"@en ,
               "ניתוח לשוני"@he ;
    rdfs:comment "Analysis of language features"@en .

hm:HistoricalContextAnalysis rdf:type owl:NamedIndividual , hm:InterpretationMethod ;
    rdfs:label "Historical Context Analysis"@en ,
               "ניתוח הקשר היסטורי"@he ;
    rdfs:comment "Analysis based on historical context"@en .

hm:ComparativeTextualAnalysis rdf:type owl:NamedIndividual , hm:InterpretationMethod ;
    rdfs:label "Comparative Textual Analysis"@en ,
               "ניתוח טקסטואלי השוואתי"@he ;
    rdfs:comment "Comparison with other manuscript witnesses"@en .

hm:AIBasedAnalysis rdf:type owl:NamedIndividual , hm:InterpretationMethod ;
    rdfs:label "AI-Based Analysis"@en ,
               "ניתוח מבוסס AI"@he ;
    rdfs:comment "Machine learning or AI-based analytical method"@en .

hm:RadiocarbonDating rdf:type owl:NamedIndividual , hm:InterpretationMethod ;
    rdfs:label "Radiocarbon Dating"@en ,
               "תיארוך פחמן-14"@he ;
    rdfs:comment "Scientific dating through radiocarbon analysis"@en .

hm:WatermarkAnalysis rdf:type owl:NamedIndividual , hm:InterpretationMethod ;
    rdfs:label "Watermark Analysis"@en ,
               "ניתוח סימני מים"@he ;
    rdfs:comment "Dating/localization through watermark identification"@en .

#################################################################
#    v1.5 - ADMINISTRATIVE & ACCESS METADATA (Comprehensive MARC Coverage)
#    Captures institutional holdings, usage rights, digital access,
#    and related materials information from NLI MARC records.
#################################################################

### v1.5 Classes

hm:PhysicalHolding rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E78_Curated_Holding ;
    rdfs:label "Physical Holding"@en ,
               "אחזקה פיזית"@he ;
    rdfs:comment "Represents a physical holding of the manuscript at a specific institution, including location details and availability status. Derived from MARC AVA fields."@en .

hm:DigitalAccess rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E73_Information_Object ;
    rdfs:label "Digital Access Point"@en ,
               "נקודת גישה דיגיטלית"@he ;
    rdfs:comment "Represents a digital access point for a manuscript, including online viewer links and IIIF endpoints. Derived from MARC AVE fields."@en .

hm:UsageRestriction rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E30_Right ;
    rdfs:label "Usage Restriction"@en ,
               "הגבלת שימוש"@he ;
    rdfs:comment "Describes usage restrictions and permissions for a manuscript, including copying rights and reproduction policies. Derived from MARC 939 fields."@en .

hm:RightsDetermination rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E30_Right ;
    rdfs:label "Rights Determination"@en ,
               "קביעת זכויות"@he ;
    rdfs:comment "Records the rights status determination for a manuscript, including domain classification and determination rationale. Derived from MARC 952 fields."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( hm:UsageRestriction hm:RightsDetermination ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hm:PhysicalHolding hm:MultiVolumeSet ) .

### v1.5 Object Properties

hm:has_physical_holding rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:holds_manuscript ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range hm:PhysicalHolding ;
    rdfs:label "has physical holding"@en ,
               "יש אחזקה פיזית"@he ;
    rdfs:comment "Links a manuscript to its physical holding information at a specific institution."@en .

hm:holds_manuscript rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:has_physical_holding ;
    rdfs:domain hm:PhysicalHolding ;
    rdfs:range lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "holds manuscript"@en ,
               "מחזיק כתב יד"@he ;
    rdfs:comment "Links a physical holding to the manuscript it holds"@en .

hm:has_digital_access rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:is_digital_access_of ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range hm:DigitalAccess ;
    rdfs:label "has digital access"@en ,
               "יש גישה דיגיטלית"@he ;
    rdfs:comment "Links a manuscript to a digital access point (online viewer, IIIF)."@en .

hm:is_digital_access_of rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:has_digital_access ;
    rdfs:domain hm:DigitalAccess ;
    rdfs:range lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "is digital access of"@en ,
               "גישה דיגיטלית של"@he ;
    rdfs:comment "Links a digital access point to the manuscript it provides access to"@en .

hm:has_usage_restriction rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:is_usage_restriction_of ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range hm:UsageRestriction ;
    rdfs:label "has usage restriction"@en ,
               "יש הגבלת שימוש"@he ;
    rdfs:comment "Links a manuscript to its usage restriction policy."@en .

hm:is_usage_restriction_of rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:has_usage_restriction ;
    rdfs:domain hm:UsageRestriction ;
    rdfs:range lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "is usage restriction of"@en ,
               "הגבלת שימוש של"@he ;
    rdfs:comment "Links a usage restriction to the manuscript it applies to"@en .

hm:has_rights_determination rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:is_rights_determination_of ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range hm:RightsDetermination ;
    rdfs:label "has rights determination"@en ,
               "יש קביעת זכויות"@he ;
    rdfs:comment "Links a manuscript to its formal rights status determination."@en .

hm:is_rights_determination_of rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:has_rights_determination ;
    rdfs:domain hm:RightsDetermination ;
    rdfs:range lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "is rights determination of"@en ,
               "קביעת זכויות של"@he ;
    rdfs:comment "Links a rights determination to the manuscript it applies to"@en .

hm:has_related_material rdf:type owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "has related material"@en ,
               "יש חומר קשור"@he ;
    rdfs:comment "Links a manuscript to related materials (other copies, fragments, related texts). Derived from MARC 544 field. Bidirectional."@en .

hm:held_at rdf:type owl:ObjectProperty ;
    rdfs:domain hm:PhysicalHolding ;
    rdfs:range cidoc-crm:E74_Group ;
    rdfs:label "held at"@en ,
               "מוחזק ב"@he ;
    rdfs:comment "Institution or sublibrary where the physical holding is located."@en .

### v1.5 Datatype Properties

hm:copyright_notice rdf:type owl:DatatypeProperty ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range xsd:string ;
    rdfs:label "copyright notice"@en ,
               "הודעת זכויות יוצרים"@he ;
    rdfs:comment "Copyright statement associated with the manuscript record. Derived from MARC 597 field."@en .

hm:related_material_note rdf:type owl:DatatypeProperty ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range xsd:string ;
    rdfs:label "related material note"@en ,
               "הערת חומר קשור"@he ;
    rdfs:comment "Free-text note about related manuscripts, copies, or fragments. Derived from MARC 544 field."@en .

hm:restriction_type rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:UsageRestriction ;
    rdfs:range xsd:string ;
    rdfs:label "restriction type"@en ,
               "סוג הגבלה"@he ;
    rdfs:comment "Type of usage restriction (free text). Prefer has_restriction_type_value for controlled values."@en .

hm:has_restriction_type_value rdf:type owl:ObjectProperty ;
    rdfs:domain hm:UsageRestriction ;
    rdfs:range hm:RestrictionType ;
    rdfs:label "has restriction type value"@en ,
               "ערך סוג הגבלה"@he ;
    rdfs:comment "Controlled vocabulary for usage restriction type"@en .

hm:restriction_url rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:UsageRestriction ;
    rdfs:range xsd:anyURI ;
    rdfs:label "restriction policy URL"@en ,
               "קישור למדיניות הגבלה"@he ;
    rdfs:comment "URL to the full usage restriction policy."@en .

hm:rights_status rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:RightsDetermination ;
    rdfs:range xsd:string ;
    rdfs:label "rights status"@en ,
               "מצב זכויות"@he ;
    rdfs:comment "The rights status classification (e.g., 'Public domain; Contract')."@en .

hm:rights_basis rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:RightsDetermination ;
    rdfs:range xsd:string ;
    rdfs:label "rights basis"@en ,
               "בסיס קביעת זכויות"@he ;
    rdfs:comment "Rationale for the rights determination (e.g., 'Over 140 years from publishing date')."@en .

hm:holding_institution rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:PhysicalHolding ;
    rdfs:range xsd:string ;
    rdfs:label "holding institution"@en ,
               "מוסד מחזיק"@he ;
    rdfs:comment "Name of the institution or sublibrary holding the item."@en .

hm:holding_sublibrary rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:PhysicalHolding ;
    rdfs:range xsd:string ;
    rdfs:label "holding sublibrary"@en ,
               "ספריית משנה"@he ;
    rdfs:comment "Sublibrary or collection within the institution."@en .

hm:holding_collection rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:PhysicalHolding ;
    rdfs:range xsd:string ;
    rdfs:label "holding collection"@en ,
               "אוסף"@he ;
    rdfs:comment "Collection name within the sublibrary."@en .

hm:holding_call_number rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:PhysicalHolding ;
    rdfs:range xsd:string ;
    rdfs:label "holding call number"@en ,
               "מספר קריאה"@he ;
    rdfs:comment "Call number or location identifier within the holding institution."@en .

hm:holding_availability rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:PhysicalHolding ;
    rdfs:range xsd:string ;
    rdfs:label "availability status"@en ,
               "מצב זמינות"@he ;
    rdfs:comment "Availability status of the physical holding."@en .

hm:digital_access_url rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:DigitalAccess ;
    rdfs:range xsd:anyURI ;
    rdfs:label "digital access URL"@en ,
               "קישור גישה דיגיטלית"@he ;
    rdfs:comment "URL for accessing the digital version of the manuscript."@en .

hm:digital_access_note rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:DigitalAccess ;
    rdfs:range xsd:string ;
    rdfs:label "digital access note"@en ,
               "הערת גישה דיגיטלית"@he ;
    rdfs:comment "Description of the digital access point (e.g., 'Online viewer', 'IIIF image')."@en .

hm:digital_access_type rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:DigitalAccess ;
    rdfs:range xsd:string ;
    rdfs:label "digital access type"@en ,
               "סוג גישה דיגיטלית"@he ;
    rdfs:comment "Type of digital access (free text). Prefer has_digital_access_type_value for controlled values."@en .

hm:has_digital_access_type_value rdf:type owl:ObjectProperty ;
    rdfs:domain hm:DigitalAccess ;
    rdfs:range hm:DigitalAccessType ;
    rdfs:label "has digital access type value"@en ,
               "ערך סוג גישה דיגיטלית"@he ;
    rdfs:comment "Controlled vocabulary for digital access type"@en .

hm:acquisition_source rdf:type owl:DatatypeProperty ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range xsd:string ;
    rdfs:label "acquisition source"@en ,
               "מקור רכישה"@he ;
    rdfs:comment "Source or donor information for the manuscript acquisition. Derived from MARC 541 field."@en .

hm:collection_name rdf:type owl:DatatypeProperty ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range xsd:string ;
    rdfs:label "collection name"@en ,
               "שם אוסף"@he ;
    rdfs:comment "Named collection the manuscript belongs to. Derived from MARC 966 field."@en .

#################################################################
#    Controlled vocabulary classes and individuals for string-typed properties
#################################################################

hm:ConsensusLevelType rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Consensus Level Type"@en ,
               "סוג רמת קונצנזוס"@he ;
    rdfs:comment "Level of scholarly consensus on an attribution or claim (e.g. unanimous, disputed)"@en .

hm:Unanimous rdf:type owl:NamedIndividual , hm:ConsensusLevelType ;
    rdfs:label "Unanimous"@en ,
               "קונצנזוס מלא"@he .

hm:Majority rdf:type owl:NamedIndividual , hm:ConsensusLevelType ;
    rdfs:label "Majority"@en ,
               "רוב"@he .

hm:Disputed rdf:type owl:NamedIndividual , hm:ConsensusLevelType ;
    rdfs:label "Disputed"@en ,
               "שנוי במחלוקת"@he .

hm:Controversial rdf:type owl:NamedIndividual , hm:ConsensusLevelType ;
    rdfs:label "Controversial"@en ,
               "שנוי במחלוקת קשה"@he .

hm:RestrictionType rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Restriction Type"@en ,
               "סוג הגבלה"@he ;
    rdfs:comment "Type of usage restriction (e.g. copying prohibited, public domain, restricted access)"@en .

hm:CopyingProhibited rdf:type owl:NamedIndividual , hm:RestrictionType ;
    rdfs:label "Copying Prohibited"@en ,
               "העתקה אסורה"@he .

hm:PublicDomain rdf:type owl:NamedIndividual , hm:RestrictionType ;
    rdfs:label "Public Domain"@en ,
               "נחלת הכלל"@he .

hm:RestrictedAccess rdf:type owl:NamedIndividual , hm:RestrictionType ;
    rdfs:label "Restricted Access"@en ,
               "גישה מוגבלת"@he .

hm:DigitalAccessType rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Digital Access Type"@en ,
               "סוג גישה דיגיטלית"@he ;
    rdfs:comment "Type of digital access (e.g. online viewer, IIIF, PDF)"@en .

hm:Viewer rdf:type owl:NamedIndividual , hm:DigitalAccessType ;
    rdfs:label "Online Viewer"@en ,
               "צופה מקוון"@he .

hm:IIIF rdf:type owl:NamedIndividual , hm:DigitalAccessType ;
    rdfs:label "IIIF"@en ,
               "IIIF"@he .

hm:PDF rdf:type owl:NamedIndividual , hm:DigitalAccessType ;
    rdfs:label "PDF"@en ,
               "PDF"@he .

[] a owl:AllDifferent ;
    owl:members ( hm:Unanimous hm:Majority hm:Disputed hm:Controversial ) .

[] a owl:AllDifferent ;
    owl:members ( hm:CopyingProhibited hm:PublicDomain hm:RestrictedAccess ) .

[] a owl:AllDifferent ;
    owl:members ( hm:Viewer hm:IIIF hm:PDF ) .

#################################################################
#    v1.9 - LOD Alignment (Canonical Properties Only)
#################################################################

hm:has_material owl:equivalentProperty <http://www.wikidata.org/prop/direct/P186> .

hm:has_script_type owl:equivalentProperty <http://www.wikidata.org/prop/direct/P6573> .

hm:external_identifier_nli owl:equivalentProperty <http://www.wikidata.org/prop/direct/P8189> .

hm:has_number_of_folios owl:equivalentProperty <http://www.wikidata.org/prop/direct/P792> .

#################################################################
#    v1.9 - Compatibility Properties for Query Interoperability
#################################################################

hm:has_expression rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf lrmoo:R4_embodies ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range lrmoo:F2_Expression ;
    rdfs:label "has expression"@en ,
               "יש ביטוי"@he ;
    rdfs:comment "Compatibility property: manuscript to expression relation used in external query templates."@en .

hm:has_work rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range lrmoo:F1_Work ;
    owl:propertyChainAxiom ( hm:has_expression lrmoo:R3i_realises ) ;
    rdfs:label "has work"@en ,
               "יש יצירה"@he ;
    rdfs:comment "Compatibility property inferred from manuscript->expression and expression->work."@en .

hm:has_author rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F1_Work ;
    rdfs:range cidoc-crm:E21_Person ;
    rdfs:label "has author"@en ,
               "יש מחבר"@he ;
    rdfs:comment "Direct work-to-author compatibility property."@en .

hm:has_expression_creation rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F1_Work ;
    rdfs:range lrmoo:F28_Expression_Creation ;
    rdfs:label "has expression creation event"@en ,
               "יש אירוע יצירת ביטוי"@he .

hm:has_production_event rdf:type owl:ObjectProperty ;
    owl:inverseOf lrmoo:R27_materialized ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range cidoc-crm:E12_Production ;
    rdfs:label "has production event"@en ,
               "יש אירוע הפקה"@he .

hm:has_production_place rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf cidoc-crm:P7_took_place_at ;
    rdfs:domain cidoc-crm:E12_Production ;
    rdfs:range cidoc-crm:E53_Place ;
    rdfs:label "has production place"@en ,
               "יש מקום הפקה"@he .

hm:has_production_time rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf cidoc-crm:P4_has_time-span ;
    rdfs:domain cidoc-crm:E12_Production ;
    rdfs:range cidoc-crm:E52_Time-Span ;
    rdfs:label "has production time"@en ,
               "יש זמן הפקה"@he ;
    rdfs:comment "Links a production event to its Time-Span."@en .

hm:has_scribe rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf cidoc-crm:P14_carried_out_by ;
    rdfs:domain cidoc-crm:E12_Production ;
    rdfs:range cidoc-crm:E21_Person ;
    rdfs:label "has scribe"@en ,
               "יש סופר"@he .

hm:has_owner rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range cidoc-crm:E39_Actor ;
    rdfs:label "has owner"@en ,
               "יש בעלים"@he .

hm:has_acquisition_event rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range cidoc-crm:E8_Acquisition ;
    rdfs:label "has acquisition event"@en ,
               "יש אירוע רכישה"@he .

hm:has_transfer_of_custody rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range cidoc-crm:E10_Transfer_of_Custody ;
    rdfs:label "has transfer of custody"@en ,
               "יש אירוע העברת משמורת"@he .

hm:has_provenance_event rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range cidoc-crm:E7_Activity ;
    rdfs:label "has provenance event"@en ,
               "יש אירוע פרובננס"@he ;
    rdfs:comment "A typed, dated, place-bearing custody event beyond production (acquisition place from MARC 541 $b, conservation/exhibition site from MARC 583 $j)."@en .

hm:is_documented_in rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf cidoc-crm:P70i_is_documented_in ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range lrmoo:F3_Manifestation ;
    rdfs:label "is documented in"@en ,
               "מתועד ב"@he .

hm:has_reference_event rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range hm:Reference_Event ;
    rdfs:label "has reference event"@en ,
               "יש אירוע הפניה"@he .

hm:is_composed_of rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:forms_part_of ;
    rdfs:subPropertyOf cidoc-crm:P46_is_composed_of ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "is composed of"@en ,
               "מורכב מ"@he .

hm:forms_part_of rdf:type owl:ObjectProperty ;
    owl:inverseOf hm:is_composed_of ;
    rdfs:subPropertyOf cidoc-crm:P46i_forms_part_of ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "forms part of"@en ,
               "מהווה חלק מ"@he .

hm:has_subject rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf cidoc-crm:P129_is_about ;
    rdfs:domain lrmoo:F1_Work ;
    rdfs:range cidoc-crm:E1_CRM_Entity ;
    rdfs:label "has subject"@en ,
               "יש נושא"@he .

hm:has_genre rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf cidoc-crm:P2_has_type ;
    rdfs:domain lrmoo:F1_Work ;
    rdfs:range cidoc-crm:E55_Type ;
    rdfs:label "has genre"@en ,
               "יש ז'אנר"@he .

hm:has_text_tradition rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf hm:witnesses ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range hm:TextTradition ;
    rdfs:label "has text tradition"@en ,
               "יש מסורת טקסט"@he .

hm:has_transmission_witness rdf:type owl:ObjectProperty ;
    rdfs:domain hm:TextTradition ;
    rdfs:range hm:TransmissionWitness ;
    rdfs:label "has transmission witness"@en ,
               "יש עד נוסח"@he .

hm:has_digital_representation rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf hm:has_digital_access ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range hm:DigitalAccess ;
    rdfs:label "has digital representation"@en ,
               "יש ייצוג דיגיטלי"@he ;
    rdfs:comment "Links a manuscript to a DigitalAccess node for its digital representation."@en .

hm:has_holding_institution rdf:type owl:ObjectProperty ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range cidoc-crm:E74_Group ;
    owl:propertyChainAxiom ( hm:has_physical_holding hm:held_at ) ;
    rdfs:label "has holding institution"@en ,
               "יש מוסד מחזיק"@he ;
    rdfs:comment "Links a manuscript to the institution (Group) that holds it."@en .

hm:has_attribution_source rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf hm:attribution_source ;
    rdfs:label "has attribution source"@en ,
               "יש מקור ייחוס"@he .

hm:has_colophon_text rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf hm:colophon_text ;
    rdfs:domain hm:Colophon ;
    rdfs:range xsd:string ;
    rdfs:label "has colophon text"@en ,
               "יש טקסט קולופון"@he .

hm:has_alternate_title rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf hm:has_title ;
    rdfs:domain lrmoo:F1_Work ;
    rdfs:range xsd:string ;
    rdfs:label "has alternate title"@en ,
               "יש כותר חלופי"@he .

hm:has_role rdf:type owl:DatatypeProperty ;
    rdfs:domain cidoc-crm:E39_Actor ;
    rdfs:range xsd:string ;
    rdfs:label "has role"@en ,
               "יש תפקיד"@he .

hm:geonames_id rdf:type owl:DatatypeProperty ;
    rdfs:domain cidoc-crm:E53_Place ;
    rdfs:range xsd:string ;
    rdfs:label "GeoNames ID"@en ,
               "מזהה GeoNames"@he .

hm:has_geonames_id rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf hm:geonames_id ;
    rdfs:domain cidoc-crm:E53_Place ;
    rdfs:range xsd:string ;
    rdfs:label "has GeoNames ID"@en ,
               "יש מזהה GeoNames"@he .

hm:lcsh_id rdf:type owl:DatatypeProperty ;
    rdfs:domain hm:SubjectType ;
    rdfs:range xsd:string ;
    rdfs:label "LCSH ID"@en ,
               "מזהה LCSH"@he .

hm:has_LCSH_id rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf hm:lcsh_id ;
    rdfs:domain hm:SubjectType ;
    rdfs:range xsd:string ;
    rdfs:label "has LCSH ID"@en ,
               "יש מזהה LCSH"@he .

hm:has_VIAF_ID rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf hm:viaf_id ;
    rdfs:domain cidoc-crm:E21_Person ;
    rdfs:range xsd:string ;
    rdfs:label "has VIAF ID"@en ,
               "יש מזהה VIAF"@he .

hm:has_production_date_certain rdf:type owl:DatatypeProperty ;
    rdfs:domain cidoc-crm:E12_Production ;
    rdfs:range xsd:boolean ;
    rdfs:label "has production date certain"@en ,
               "וודאות תאריך הפקה"@he .

hm:iiif_manifest_url rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf hm:digital_access_url ;
    rdfs:domain hm:DigitalAccess ;
    rdfs:range xsd:anyURI ;
    rdfs:label "IIIF manifest URL"@en ,
               "כתובת IIIF manifest"@he .

hm:usage_restriction_note rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf hm:restriction_type ;
    rdfs:domain hm:UsageRestriction ;
    rdfs:range xsd:string ;
    rdfs:label "usage restriction note"@en ,
               "הערת הגבלת שימוש"@he .

hm:has_censorship_mark rdf:type owl:DatatypeProperty ;
    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
    rdfs:range xsd:boolean ;
    rdfs:label "has censorship mark"@en ,
               "יש סימן צנזורה"@he .

