#################################################################
#    Classes
#################################################################

### LRMoo Classes

lrmoo:F1_Work rdf:type owl:Class ;
    rdfs:label "Work"@en ,
               "יצירה"@he ;
    rdfs:comment "An abstract intellectual creation"@en .

lrmoo:F2_Expression rdf:type owl:Class ;
    rdfs:label "Expression"@en ,
               "ביטוי"@he ;
    rdfs:comment "The intellectual or artistic realization of a work"@en .

lrmoo:F3_Manifestation rdf:type owl:Class ;
    rdfs:label "Manifestation"@en ,
               "מהדורה"@he ;
    rdfs:comment "The physical embodiment of an expression"@en .

lrmoo:F4_Manifestation_Singleton rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E22_Human-Made_Object ;
    rdfs:label "Manifestation Singleton"@en ,
               "עותק יחידני"@he ;
    rdfs:comment "A unique physical object - the manuscript"@en .

lrmoo:F27_Work_Creation rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E65_Creation ;
    rdfs:label "Work Creation"@en ,
               "יצירת יצירה"@he ;
    rdfs:comment "LRMoo event class: creation of a Work (F1)."@en .

lrmoo:F28_Expression_Creation rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E65_Creation ;
    rdfs:label "Expression Creation"@en ,
               "יצירת ביטוי"@he ;
    rdfs:comment "LRMoo event class: creation of an Expression (F2)."@en .

lrmoo:F30_Manifestation_Creation rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E65_Creation ;
    rdfs:label "Manifestation Creation"@en ,
               "יצירת מהדורה"@he ;
    rdfs:comment "LRMoo event class: creation of a Manifestation (F3)."@en .

lrmoo:F32_Item_Production_Event rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E12_Production ;
    rdfs:label "Item Production Event"@en ,
               "אירוע ייצור עותק"@he ;
    rdfs:comment "LRMoo event class: production of a physical Item (F5)."@en .

lrmoo:F5_Item rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E22_Human-Made_Object ;
    rdfs:label "Item"@en ,
               "פריט"@he ;
    rdfs:comment "LRMoo class for a physical item (subclass of human-made object)."@en .

### CIDOC-CRM Classes

cidoc-crm:E10_Transfer_of_Custody rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E7_Activity ;
    rdfs:label "Transfer of Custody"@en ,
               "העברת משמורת"@he ;
    rdfs:comment "CIDOC-CRM activity transferring custody of an object."@en .

cidoc-crm:E12_Production rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E7_Activity ;
    rdfs:label "Production"@en ,
               "ייצור"@he ;
    rdfs:comment "CIDOC-CRM activity that brings an object into existence."@en .

cidoc-crm:E18_Physical_Thing rdf:type owl:Class ;
    rdfs:label "Physical Thing"@en ;
    rdfs:comment "CIDOC-CRM root class for material entities."@en .

cidoc-crm:E26_Physical_Feature rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E18_Physical_Thing ;
    rdfs:label "Physical Feature"@en ;
    rdfs:comment "CIDOC-CRM class for a discernible part of a physical thing."@en .

cidoc-crm:E21_Person rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E39_Actor ;
    rdfs:label "Person"@en ,
               "אדם"@he ;
    rdfs:comment "CIDOC-CRM class for an individual human being."@en .

cidoc-crm:E22_Human-Made_Object rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E18_Physical_Thing ;
    rdfs:label "Human-Made Object"@en ;
    rdfs:comment "CIDOC-CRM class for objects intentionally made by humans."@en .

cidoc-crm:E31_Document rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E73_Information_Object ;
    rdfs:label "Document"@en ,
               "מסמך"@he ;
    rdfs:comment "CIDOC-CRM class for a material information carrier."@en .

cidoc-crm:E33_Linguistic_Object rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E73_Information_Object ;
    rdfs:label "Linguistic Object"@en ,
               "אובייקט לשוני"@he ;
    rdfs:comment "CIDOC-CRM class for a linguistic expression as information object."@en .

cidoc-crm:E35_Title rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E33_Linguistic_Object ;
    rdfs:label "Title"@en ,
               "כותרת"@he ;
    rdfs:comment "CIDOC-CRM class for a name or title (linguistic object)."@en .

cidoc-crm:E39_Actor rdf:type owl:Class ;
    rdfs:label "Actor"@en ,
               "פועל"@he ;
    rdfs:comment "CIDOC-CRM class for an agent capable of carrying out actions."@en .

cidoc-crm:E42_Identifier rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E33_Linguistic_Object ;
    rdfs:label "Identifier"@en ,
               "מזהה"@he ;
    rdfs:comment "CIDOC-CRM class for an identifier assigned to an entity."@en .

cidoc-crm:E52_Time-Span rdf:type owl:Class ;
    rdfs:label "Time-Span"@en ,
               "פרק זמן"@he ;
    rdfs:comment "CIDOC-CRM class for a temporal extent with optional bounds."@en .

cidoc-crm:E53_Place rdf:type owl:Class ;
    rdfs:label "Place"@en ,
               "מקום"@he ;
    rdfs:comment "CIDOC-CRM class for a geographic or conceptual place."@en .

cidoc-crm:E55_Type rdf:type owl:Class ;
    rdfs:label "Type"@en ,
               "סוג"@he ;
    rdfs:comment "CIDOC-CRM class for a categorical type or classification."@en .

cidoc-crm:E56_Language rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Language"@en ,
               "שפה"@he ;
    rdfs:comment "CIDOC-CRM class for a natural language."@en .

cidoc-crm:E57_Material rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Material"@en ,
               "חומר"@he ;
    rdfs:comment "CIDOC-CRM class for a substance used in production."@en .

cidoc-crm:E65_Creation rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E7_Activity ;
    rdfs:label "Creation"@en ,
               "יצירה"@he ;
    rdfs:comment "CIDOC-CRM activity class for bringing something into being."@en .

cidoc-crm:E73_Information_Object rdf:type owl:Class ;
    rdfs:label "Information Object"@en ,
               "אובייקט מידע"@he ;
    rdfs:comment "CIDOC-CRM class for an intangible content-bearing object."@en .

cidoc-crm:E74_Group rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E39_Actor ;
    rdfs:label "Group"@en ,
               "קבוצה"@he ;
    rdfs:comment "CIDOC-CRM class for a persistent group of two or more actors."@en .

cidoc-crm:E7_Activity rdf:type owl:Class ;
    rdfs:label "Activity"@en ,
               "פעילות"@he ;
    rdfs:comment "CIDOC-CRM class for a purposeful event over time."@en .

cidoc-crm:E8_Acquisition rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E7_Activity ;
    rdfs:label "Acquisition"@en ,
               "רכישה"@he ;
    rdfs:comment "CIDOC-CRM activity transferring title to an object."@en .

### Hebrew Manuscripts Custom Classes

hm:Bibliographic_Unit rdf:type owl:Class ;
    rdfs:subClassOf lrmoo:F4_Manifestation_Singleton ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty lrmoo:R5_has_component ;
        owl:someValuesFrom hm:Codicological_Unit ] ;
    rdfs:label "Bibliographic Unit"@en ,
               "יחידה ביבליוגרפית"@he ;
    rdfs:comment "A manuscript or book as a cataloging unit"@en .

hm:Codicological_Unit rdf:type owl:Class ;
    rdfs:subClassOf lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "Codicological Unit"@en ,
               "יחידה קודיקולוגית"@he ;
    rdfs:comment "A section produced as a physical unit"@en .

hm:Colophon rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E33_Linguistic_Object ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty hm:colophon_text ;
        owl:someValuesFrom xsd:string ] ;
    rdfs:label "Colophon"@en ,
               "קולופון"@he ;
    rdfs:comment "Scribe's statement at the end of a text. Every Colophon instance must have at least one hm:colophon_text value (string)."@en .

hm:HebrewScriptType rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Hebrew Script Type"@en ,
               "סוג כתב עברי"@he ;
    rdfs:comment "Type of Hebrew script (e.g. by region or by form: square, semicursive, cursive)"@en .

hm:ModeScriptType rdf:type owl:Class ;
    rdfs:subClassOf hm:HebrewScriptType ;
    rdfs:label "Script Mode Type"@en ,
               "סוג אופן הכתב"@he ;
    rdfs:comment "Square, Semicursive, or Cursive"@en .

hm:TypeScriptType rdf:type owl:Class ;
    rdfs:subClassOf hm:HebrewScriptType ;
    rdfs:label "Script Regional Type"@en ,
               "סוג כתב אזורי"@he ;
    rdfs:comment "Ashkenazi, Sephardic, Byzantine, etc."@en .

hm:Paleographical_Unit rdf:type owl:Class ;
    rdfs:subClassOf lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "Paleographical Unit"@en ,
               "יחידה פליאוגרפית"@he ;
    rdfs:comment "Section with consistent script characteristics"@en .

hm:ModeScriptType owl:disjointWith hm:TypeScriptType .

[] a owl:AllDisjointClasses ;
    owl:members ( hm:Bibliographic_Unit hm:Codicological_Unit hm:Paleographical_Unit ) .

hm:ParticipationRole rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Participation Role"@en ,
               "תפקיד השתתפות"@he ;
    rdfs:comment "HMO controlled type for a person's role in an event."@en .

hm:Reference_Event rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E7_Activity ;
    rdfs:label "Reference Event"@en ,
               "אירוע הפניה"@he ;
    rdfs:comment "Event in which a manuscript or part of it is referenced (e.g. citation, mention)"@en .

hm:SubjectType rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Subject Type"@en ,
               "נושא"@he ;
    rdfs:comment "Type of subject or genre of a work (e.g. halakha, liturgy, philosophy)"@en .

### NEW Classes (Added in v1.1)

hm:Binding rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E22_Human-Made_Object ;
    rdfs:label "Binding"@en ,
               "כריכה"@he ;
    rdfs:comment "Physical binding of a manuscript"@en .

hm:Decoration rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E22_Human-Made_Object ;
    rdfs:label "Decoration"@en ,
               "קישוט"@he ;
    rdfs:comment "Decorative element in a manuscript"@en .

hm:DecorationType rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Decoration Type"@en ,
               "סוג קישוט"@he ;
    rdfs:comment "Type of decoration in a manuscript (e.g. illumination, micrography, border)"@en .

hm:Marginalia rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E33_Linguistic_Object ;
    rdfs:label "Marginalia"@en ,
               "הערות שוליים"@he ;
    rdfs:comment "Marginal annotations in a manuscript"@en .

hm:Watermark rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E26_Physical_Feature ;
    rdfs:label "Watermark"@en ,
               "סימן מים"@he ;
    rdfs:comment "Physical feature (e.g. in paper) used for dating or provenance"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( hm:Colophon hm:Binding hm:Decoration hm:Marginalia hm:Watermark ) .

hm:ConditionType rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Condition Type"@en ,
               "סוג מצב"@he ;
    rdfs:comment "HMO controlled type for physical condition category."@en .

hm:VocalizationType rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Vocalization Type"@en ,
               "סוג ניקוד"@he ;
    rdfs:comment "HMO controlled type for Hebrew vocalization system."@en .

hm:BindingType rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Binding Type"@en ,
               "סוג כריכה"@he ;
    rdfs:comment "HMO controlled type for manuscript binding style."@en .

hm:DateFormatType rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Date Format Type"@en ,
               "סוג פורמט תאריך"@he ;
    rdfs:comment "Classification of date format: Gregorian year (YYYY), Hebrew year (תשפ״ד), full date (DD/MM/YYYY), or unstructured text"@en .

### NEW Classes addressing reviewer feedback (v1.2)

hm:CertaintyLevel rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Certainty Level"@en ,
               "רמת וודאות"@he ;
    rdfs:comment "Degree of certainty for attributions (certain, probable, possible, uncertain)"@en .

hm:AttributionSource rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Attribution Source"@en ,
               "מקור ייחוס"@he ;
    rdfs:comment "Type of source for an attribution (expert, AI, catalog, colophon)"@en .

hm:MultiVolumeSet rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E78_Curated_Holding ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty hm:has_volume ;
        owl:minCardinality 2 ] ;
    rdfs:label "Multi-Volume Set"@en ,
               "סט רב-כרכי"@he ;
    rdfs:comment "A set of manuscript volumes that belong together (at least 2 volumes required)"@en .

hm:AnthologyStructure rdf:type owl:Class ;
    rdfs:subClassOf lrmoo:F4_Manifestation_Singleton ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( lrmoo:F4_Manifestation_Singleton
            [ a owl:Restriction ;
              owl:onProperty lrmoo:R4_embodies ;
              owl:someValuesFrom [ a owl:Class ;
                owl:intersectionOf ( lrmoo:F2_Expression
                    [ a owl:Restriction ;
                      owl:onProperty hm:has_anthology_position ;
                      owl:someValuesFrom hm:AnthologyPosition ] ) ] ] ) ] ;
    rdfs:label "Anthology Structure"@en ,
               "מבנה אנתולוגי"@he ;
    rdfs:comment "Manuscript with intentional anthology arrangement"@en .

hm:AnthologyPosition rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E28_Conceptual_Object ;
    rdfs:label "Anthology Position"@en ,
               "מיקום באנתולוגיה"@he ;
    rdfs:comment "Position of a text within an anthology with ordering info"@en .

hm:ScribalIntervention rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E7_Activity ;
    rdfs:label "Scribal Intervention"@en ,
               "התערבות סופר"@he ;
    rdfs:comment "Corrections, additions, or modifications made by scribes"@en .

hm:TextCorrection rdf:type owl:Class ;
    rdfs:subClassOf hm:ScribalIntervention ;
    rdfs:label "Text Correction"@en ,
               "תיקון טקסט"@he ;
    rdfs:comment "Scribal intervention that corrects or emends the text"@en .

hm:MarginalAddition rdf:type owl:Class ;
    rdfs:subClassOf hm:ScribalIntervention ;
    rdfs:label "Marginal Addition"@en ,
               "הוספה בשוליים"@he ;
    rdfs:comment "Scribal intervention that adds text in the margins"@en .

hm:HandChange rdf:type owl:Class ;
    rdfs:subClassOf hm:ScribalIntervention ;
    rdfs:label "Hand Change"@en ,
               "חילופי יד"@he ;
    rdfs:comment "Point where one scribe's work ends and another begins"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( hm:TextCorrection hm:MarginalAddition hm:HandChange ) .

hm:TextLocation rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E28_Conceptual_Object ;
    rdfs:label "Text Location"@en ,
               "מיקום בטקסט"@he ;
    rdfs:comment "Specific location within a manuscript (folio, line, column)"@en .

hm:LostManuscript rdf:type owl:Class ;
    rdfs:subClassOf lrmoo:F4_Manifestation_Singleton ;
    rdfs:label "Lost Manuscript"@en ,
               "כתב יד אבוד"@he ;
    rdfs:comment "A manuscript that no longer exists but is known through copies or references"@en .

hm:HypotheticalExemplar rdf:type owl:Class ;
    rdfs:subClassOf hm:LostManuscript ;
    rdfs:label "Hypothetical Exemplar"@en ,
               "אב טיפוס משוער"@he ;
    rdfs:comment "A reconstructed source manuscript based on textual analysis"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( hm:LostManuscript hm:AnthologyStructure ) .

### NEW Classes for v1.3 - Text Tradition Layer (Hybrid Philological Approach)

## Text Tradition Classes

hm:TextTradition rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E28_Conceptual_Object ;
    rdfs:label "Text Tradition"@en ,
               "מסורת טקסטואלית"@he ;
    rdfs:comment "A transmission stream of a text, independent of 'original Work' concept. Supports philological view where each MS is a unique cultural event."@en .

hm:TransmissionWitness rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E73_Information_Object ;
    rdfs:label "Transmission Witness"@en ,
               "עד מסירה"@he ;
    rdfs:comment "A manuscript viewed as witness to a textual tradition rather than just a 'copy'"@en .

hm:TextualVariant rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E73_Information_Object ;
    rdfs:label "Textual Variant"@en ,
               "גרסה טקסטואלית"@he ;
    rdfs:comment "A specific variant reading within a textual tradition"@en .

hm:StemmaPosition rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E28_Conceptual_Object ;
    rdfs:label "Stemma Position"@en ,
               "מיקום בסטמה"@he ;
    rdfs:comment "Position of a manuscript in a textual stemma (for critical edition work)"@en .

hm:StemmaHypothesis rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E28_Conceptual_Object ;
    rdfs:label "Stemma Hypothesis"@en ,
               "השערת סטמה"@he ;
    rdfs:comment "A scholarly hypothesis about textual relationships"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( hm:TextTradition hm:TransmissionWitness hm:TextualVariant hm:StemmaPosition hm:StemmaHypothesis ) .

## Full Granularity Location Classes

hm:FolioLocation rdf:type owl:Class ;
    rdfs:subClassOf hm:TextLocation ;
    rdfs:label "Folio Location"@en ,
               "מיקום דף"@he ;
    rdfs:comment "Location at folio/page level (e.g., '15r')"@en .

hm:LineLocation rdf:type owl:Class ;
    rdfs:subClassOf hm:TextLocation ;
    rdfs:label "Line Location"@en ,
               "מיקום שורה"@he ;
    rdfs:comment "Location at line level (e.g., '15r, line 5')"@en .

hm:WordLocation rdf:type owl:Class ;
    rdfs:subClassOf hm:TextLocation ;
    rdfs:label "Word Location"@en ,
               "מיקום מילה"@he ;
    rdfs:comment "Location at word level (e.g., '15r, line 5, word 3')"@en .

hm:CharacterLocation rdf:type owl:Class ;
    rdfs:subClassOf hm:TextLocation ;
    rdfs:label "Character Location"@en ,
               "מיקום תו"@he ;
    rdfs:comment "Location at character level (for paleographic analysis)"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( hm:FolioLocation hm:LineLocation hm:WordLocation hm:CharacterLocation hm:TextSpan ) .

hm:TextSpan rdf:type owl:Class ;
    rdfs:subClassOf hm:TextLocation ;
    rdfs:label "Text Span"@en ,
               "טווח טקסט"@he ;
    rdfs:comment "A range from location A to location B"@en .

hm:IIIFRegion rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E73_Information_Object ;
    rdfs:label "IIIF Region"@en ,
               "אזור IIIF"@he ;
    rdfs:comment "Reference to IIIF image region for visual location"@en .

## Canonical Reference Classes

hm:CanonicalReference rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E28_Conceptual_Object ;
    rdfs:label "Canonical Reference"@en ,
               "הפניה קנונית"@he ;
    rdfs:comment "Reference to canonical Jewish text structure"@en .

hm:BiblicalReference rdf:type owl:Class ;
    rdfs:subClassOf hm:CanonicalReference ;
    rdfs:label "Biblical Reference"@en ,
               "הפניה מקראית"@he ;
    rdfs:comment "Book/Chapter/Verse reference (e.g., Genesis 1:1)"@en .

hm:MishnaicReference rdf:type owl:Class ;
    rdfs:subClassOf hm:CanonicalReference ;
    rdfs:label "Mishnaic Reference"@en ,
               "הפניה משנאית"@he ;
    rdfs:comment "Tractate/Chapter/Mishnah reference"@en .

hm:TalmudicReference rdf:type owl:Class ;
    rdfs:subClassOf hm:CanonicalReference ;
    rdfs:label "Talmudic Reference"@en ,
               "הפניה תלמודית"@he ;
    rdfs:comment "Tractate/Folio/Side reference (e.g., Berakhot 2a)"@en .

hm:HalachicReference rdf:type owl:Class ;
    rdfs:subClassOf hm:CanonicalReference ;
    rdfs:label "Halachic Reference"@en ,
               "הפניה הלכתית"@he ;
    rdfs:comment "Reference for Mishneh Torah or Shulchan Aruch"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( hm:BiblicalReference hm:MishnaicReference hm:TalmudicReference hm:HalachicReference ) .

hm:CanonicalHierarchyType rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Canonical Hierarchy Type"@en ,
               "סוג היררכיה קנונית"@he ;
    rdfs:comment "Type of canonical text hierarchy (Bible, Mishnah, etc.)"@en .

## Unit Status Classes

hm:UnitStatusType rdf:type owl:Class ;
    rdfs:subClassOf cidoc-crm:E55_Type ;
    rdfs:label "Unit Status Type"@en ,
               "סוג סטטוס יחידה"@he ;
    rdfs:comment "Type indicating if unit is core or foreign to manuscript"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( hm:ConditionType hm:VocalizationType hm:BindingType hm:DateFormatType hm:CertaintyLevel hm:AttributionSource hm:DecorationType hm:SubjectType hm:ParticipationRole hm:CanonicalHierarchyType hm:UnitStatusType hm:EpistemologicalStatus hm:DataCategory hm:InterpretationMethod hm:ConsensusLevelType hm:RestrictionType hm:DigitalAccessType hm:HierarchyType hm:ViewType hm:HebrewScriptType ) .

