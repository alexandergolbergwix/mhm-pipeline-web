###  http://www.ontology.org.il/HebrewManuscripts/2025-08-19#Bibliographic_Unit
HebrewManuscripts:Bibliographic_Unit rdf:type owl:Class ;
                                     rdfs:subClassOf lrmoo:F4_Manifestation_Singleton ;
                                     rdfs:comment "(Hebrew): \"הישות הפיזית השלמה של כתב יד עם מספר מדף בספרייה. יכולה להכיל יחידה קודיקולוגית אחת (unified codex) או מספר יחידות (assembled codex).\"" ;
                                     rdfs:label "Bibliographic Unit"@en ,
                                                "יחידה ביבליוגרפית"@he .


###  http://www.ontology.org.il/HebrewManuscripts/2025-08-19#Codicological_Unit
HebrewManuscripts:Codicological_Unit rdf:type owl:Class ;
                                     rdfs:subClassOf lrmoo:F4_Manifestation_Singleton ;
                                     rdfs:comment "(Hebrew): \"יחידת הקטלוג הבסיסית המתארת חלק של כתב יד שיוצר במקום וזמן ספציפיים על ידי סופר או קבוצת סופרים.\"" ;
                                     rdfs:label "\"Codicological Unit\""@en ,
                                                "יחידה קודיקולוגית"@he .


