@prefix : <http://data.hebrewmanuscripts.org/ontology/vatican44/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix cidoc-crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix HebrewManuscripts: <http://www.ontology.org.il/HebrewManuscripts/2025-08-19#> .
@base <http://data.hebrewmanuscripts.org/ontology/vatican44/> .

<http://www.ontology.org.il/HebrewManuscripts/2025-08-19> rdf:type owl:Ontology ;
                                                           owl:versionIRI <http://www.ontology.org.il/HebrewManuscripts/2025-08-19/1.0> ;
                                                           owl:imports <http://iflastandards.info/ns/lrm/lrmoo/1.0> .

#################################################################
#    Annotation properties
#################################################################

###  http://iflastandards.info/ns/lrm/lrmoo/R16_created
lrmoo:R16_created rdf:type owl:AnnotationProperty .


###  http://iflastandards.info/ns/lrm/lrmoo/R27_materialized
lrmoo:R27_materialized rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#sameAs
owl:sameAs rdf:type owl:AnnotationProperty ;
           rdfs:range owl:Thing .


#################################################################
#    Object Properties
#################################################################

###  http://iflastandards.info/ns/lrm/lrmoo/R3_is_realised_in
lrmoo:R3_is_realised_in rdfs:domain lrmoo:F1_Work ;
                        rdfs:range lrmoo:F2_Expression .


###  http://iflastandards.info/ns/lrm/lrmoo/R4_embodies
lrmoo:R4_embodies rdfs:domain lrmoo:F4_Manifestation_Singleton .


###  http://iflastandards.info/ns/lrm/lrmoo/R4i_is_embodied_in
lrmoo:R4i_is_embodied_in rdfs:domain lrmoo:F2_Expression ;
                         rdfs:range lrmoo:F3_Manifestation ,
                                    lrmoo:F4_Manifestation_Singleton .


###  http://iflastandards.info/ns/lrm/lrmoo/R5_has_component
lrmoo:R5_has_component rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf cidoc-crm:P46_is_composed_of ;
                       rdf:type owl:TransitiveProperty ;
                       rdfs:domain lrmoo:F4_Manifestation_Singleton ;
                       rdfs:range lrmoo:F3_Manifestation ,
                                  lrmoo:F4_Manifestation_Singleton ;
                       rdfs:comment """R5 has component is a specialization of P46 is composed of, 
used specifically for bibliographic entities (Manifestations, manuscripts)."""@en ,
                                    """Domain/Range: F3 Manifestation ↔ F3 Manifestation

משמעות: קישור פיזי/ביבליו־טכני בין חלקי מהדורה (Manifestation).

שימוש: תיאור חלוקה של מהדורה לחלקים פיזיים.

דוגמאות:

מהדורת תלמוד בבלי מורכבת מ־6 כרכים (כל כרך הוא Manifestation).

כתב יד גדול מורכב משני כרכים (כרך א' + כרך ב').""" .


###  http://iflastandards.info/ns/lrm/lrmoo/R5i_is_component_by
lrmoo:R5i_is_component_by rdfs:subPropertyOf cidoc-crm:P46_is_composed_of .


###  http://iflastandards.info/ns/lrmoo/R10_has_member
<http://iflastandards.info/ns/lrmoo/R10_has_member> rdf:type owl:ObjectProperty ;
                                                    owl:inverseOf <http://iflastandards.info/ns/lrmoo/R10i_is_member_of> ;
                                                    rdfs:domain lrmoo:F1_Work ;
                                                    rdfs:range lrmoo:F1_Work ;
                                                    rdfs:comment """Domain/Range: F1 Work ↔ F1 Work

משמעות: קישור אינטלקטואלי/תוכני בין חלקי יצירה (Work).

שימוש: תיאור מבנה היררכי של יצירה מבחינה רעיונית/ספרותית.

דוגמאות:

משנה תורה כוללת את ספר המדע, ספר אהבה, ספר זמנים וכו'.

תנ\"ך כולל את תורה, נביאים, כתובים.""" .


###  http://iflastandards.info/ns/lrmoo/R10i_is_member_of
<http://iflastandards.info/ns/lrmoo/R10i_is_member_of> rdf:type owl:ObjectProperty .


###  http://iflastandards.info/ns/lrmoo/R16_created
<http://iflastandards.info/ns/lrmoo/R16_created> rdf:type owl:ObjectProperty ;
                                                 rdfs:subPropertyOf cidoc-crm:P94_has_created ;
                                                 rdfs:domain <http://iflastandards.info/ns/lrmoo/F27_Work_Creation> ;
                                                 rdfs:range lrmoo:F1_Work ;
                                                 rdfs:label "created (Work Creation → Work)"@en .


###  http://iflastandards.info/ns/lrmoo/R17_created
<http://iflastandards.info/ns/lrmoo/R17_created> rdf:type owl:ObjectProperty ;
                                                 rdfs:subPropertyOf cidoc-crm:P94_has_created ;
                                                 rdfs:domain <http://iflastandards.info/ns/lrmoo/F28_Expression_Creation> ;
                                                 rdfs:range lrmoo:F2_Expression ;
                                                 rdfs:label "created (Expression Creation → Expression)"@en .


###  http://iflastandards.info/ns/lrmoo/R24_created
<http://iflastandards.info/ns/lrmoo/R24_created> rdf:type owl:ObjectProperty ;
                                                 rdfs:subPropertyOf cidoc-crm:P94_has_created ;
                                                 rdfs:domain <http://iflastandards.info/ns/lrmoo/F30_Manifestation_Creation> ;
                                                 rdfs:range lrmoo:F3_Manifestation ;
                                                 rdfs:label "created (Manifestation Creation → Manifestation)"@en .


###  http://iflastandards.info/ns/lrmoo/R27_materialized
<http://iflastandards.info/ns/lrmoo/R27_materialized> rdf:type owl:ObjectProperty ;
                                                      rdfs:subPropertyOf cidoc-crm:P94_has_created ;
                                                      rdfs:domain <http://iflastandards.info/ns/lrmoo/F32_Item_Production_Event> ;
                                                      rdfs:range lrmoo:F4_Manifestation_Singleton ;
                                                      rdfs:label "materialized (Item Production → Item)"@en .


###  http://iflastandards.info/ns/lrmoo/R69_has_physical_form
<http://iflastandards.info/ns/lrmoo/R69_has_physical_form> rdf:type owl:ObjectProperty ;
                                                           rdfs:subPropertyOf owl:topObjectProperty ;
                                                           rdfs:domain lrmoo:F3_Manifestation ,
                                                                       lrmoo:F4_Manifestation_Singleton ;
                                                           rdfs:range cidoc-crm:E55_Type ;
                                                           rdfs:comment """This property associates an instance of F3 [F4]
 Manifestation with an instance of E55 Type
describing the kind of physical form that characterizes instances of F5 Item carrying this
F3 Manifestation.""" ;
                                                           rdfs:label "as physical form"@en ,
                                                                      "בעל צורה פיסית"@he .


###  http://iflastandards.info/ns/lrmoo/R7_exemplifies
<http://iflastandards.info/ns/lrmoo/R7_exemplifies> rdf:type owl:ObjectProperty ;
                                                    owl:inverseOf <http://iflastandards.info/ns/lrmoo/R7i_is_exemplified_by> ;
                                                    rdfs:domain lrmoo:F4_Manifestation_Singleton ;
                                                    rdfs:range lrmoo:F3_Manifestation ;
                                                    rdfs:comment "עותק יחידני (כתב יד או ספר מודפס) מגלם מהדורה (Manifestation). לדוגמה: כתב יד פריס Heb. 671 מגלם את המהדורה הספרדית של 'משנה תורה'.\""@he ;
                                                    rdfs:label "exemplifies"@en ,
                                                               "מגלם"@he .


###  http://iflastandards.info/ns/lrmoo/R7i_is_exemplified_by
<http://iflastandards.info/ns/lrmoo/R7i_is_exemplified_by> rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P102_has_title
cidoc-crm:P102_has_title rdf:type owl:ObjectProperty ;
                         rdfs:domain cidoc-crm:E22_Human-Made_Object ;
                         rdfs:range cidoc-crm:E35_Title ;
                         rdfs:comment "מקשרת בין אובייקט לכותרת שלו" .


###  http://www.cidoc-crm.org/cidoc-crm/P138i_has_representation
cidoc-crm:P138i_has_representation rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf owl:topObjectProperty ;
                                   rdfs:range cidoc-crm:E73_Information_Object ;
                                   rdfs:label "has representation@en" ,
                                              "יש ייצוג@he" .


###  http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by
cidoc-crm:P14_carried_out_by rdf:type owl:ObjectProperty ;
                             rdfs:domain cidoc-crm:E7_Activity ;
                             rdfs:range cidoc-crm:E39_Actor ;
                             rdfs:label "carried out by"@en ,
                                        "בוצע על ידי"@he .


###  http://www.cidoc-crm.org/cidoc-crm/P16_used_specific_object
cidoc-crm:P16_used_specific_object rdf:type owl:ObjectProperty ;
                                   rdfs:domain cidoc-crm:E7_Activity ;
                                   rdfs:comment """MS_Barberini_82_Digitization_Event P16_used_specific_object MS_Barberini_82
זה אומר: אירוע הדיגיטציה השתמש בכתב היד הפיזי ברברין 82 כדי ליצור את הגרסה הדיגיטלית\"""" ;
                                   rdfs:label "used specific object@en" ,
                                              "השתמש בחפץ ספציפי@he" .


###  http://www.cidoc-crm.org/cidoc-crm/P16i_was_used_for
cidoc-crm:P16i_was_used_for rdf:type owl:ObjectProperty ;
                            rdfs:domain lrmoo:F4_Manifestation_Singleton ;
                            rdfs:range cidoc-crm:E7_Activity ;
                            rdfs:label "was used for@en" ,
                                       "שימש עבור@he" .


###  http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by
cidoc-crm:P1_is_identified_by rdf:type owl:ObjectProperty ;
                              rdfs:domain lrmoo:F4_Manifestation_Singleton ;
                              rdfs:range cidoc-crm:E42_Identifier ;
                              rdfs:label "is identified by"@en ,
                                         "מזוהה על ידי"@he .


###  http://www.cidoc-crm.org/cidoc-crm/P23_transferred_title_to
cidoc-crm:P23_transferred_title_to rdf:type owl:ObjectProperty ;
                                   owl:inverseOf cidoc-crm:P24_transferred_title_from ;
                                   rdfs:domain cidoc-crm:E8_Acquisition ;
                                   rdfs:range cidoc-crm:E39_Actor ;
                                   rdfs:label "transferred title to"@en ,
                                              "הועבר אל"@he .


###  http://www.cidoc-crm.org/cidoc-crm/P24_transferred_title_from
cidoc-crm:P24_transferred_title_from rdf:type owl:ObjectProperty ;
                                     rdfs:domain cidoc-crm:E8_Acquisition ;
                                     rdfs:range cidoc-crm:E39_Actor ;
                                     rdfs:label "transferred title from"@en ,
                                                "הועבר מ"@he .


###  http://www.cidoc-crm.org/cidoc-crm/P28_custody_surrendered_by
cidoc-crm:P28_custody_surrendered_by rdf:type owl:ObjectProperty ;
                                     owl:inverseOf cidoc-crm:P28i_custody_surrendered_in ;
                                     rdfs:domain cidoc-crm:E10_Transfer_of_Custody ;
                                     rdfs:range cidoc-crm:E39_Actor ;
                                     rdfs:label "custody surrendered by"@en ,
                                                "מסר משמורת"@he .


###  http://www.cidoc-crm.org/cidoc-crm/P28i_custody_surrendered_in
cidoc-crm:P28i_custody_surrendered_in rdf:type owl:ObjectProperty ;
                                      rdfs:domain cidoc-crm:E39_Actor ;
                                      rdfs:range cidoc-crm:E10_Transfer_of_Custody .


###  http://www.cidoc-crm.org/cidoc-crm/P29_custody_received_by
cidoc-crm:P29_custody_received_by rdf:type owl:ObjectProperty ;
                                  rdfs:domain cidoc-crm:E10_Transfer_of_Custody ;
                                  rdfs:range cidoc-crm:E39_Actor ;
                                  rdfs:label "custody received by"@en ,
                                             "קיבל משמורת"@he .


###  http://www.cidoc-crm.org/cidoc-crm/P2_has_type
cidoc-crm:P2_has_type rdf:type owl:ObjectProperty ;
                      rdfs:range cidoc-crm:E55_Type ;
                      rdfs:label "has type"@en ,
                                 "מסוג"@he .


###  http://www.cidoc-crm.org/cidoc-crm/P46_is_composed_of
cidoc-crm:P46_is_composed_of rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf owl:topObjectProperty ;
                             rdfs:domain cidoc-crm:E22_Human-Made_Object ;
                             rdfs:range cidoc-crm:E22_Human-Made_Object ;
                             rdfs:label "is composed of"@en ,
                                        "מורכב מ"@he .


###  http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span
cidoc-crm:P4_has_time-span rdf:type owl:ObjectProperty ;
                           rdfs:domain cidoc-crm:E7_Activity ;
                           rdfs:range cidoc-crm:E52_Time-Span ;
                           rdfs:label "has time-span@en" ,
                                      "תקופת זמן@he" .


###  http://www.cidoc-crm.org/cidoc-crm/P70_documents
cidoc-crm:P70_documents rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf owl:topObjectProperty ;
                        rdfs:domain lrmoo:F3_Manifestation ;
                        rdfs:range lrmoo:F4_Manifestation_Singleton ;
                        rdfs:label "documents"@en ,
                                   "מתעד"@he .


###  http://www.cidoc-crm.org/cidoc-crm/P70i_is_documented_in
cidoc-crm:P70i_is_documented_in rdf:type owl:ObjectProperty ;
                                rdfs:domain lrmoo:F4_Manifestation_Singleton ;
                                rdfs:range lrmoo:F3_Manifestation ;
                                rdfs:comment "Links a manuscript to bibliographic sources that document it" ;
                                rdfs:label "is documented in"@en ,
                                           "מתועד ב"@he .


###  http://www.cidoc-crm.org/cidoc-crm/P72_has_language
cidoc-crm:P72_has_language rdf:type owl:ObjectProperty ;
                           rdfs:domain lrmoo:F2_Expression ;
                           rdfs:range cidoc-crm:E56_Language ;
                           rdfs:label "has language\""@en ,
                                      "כתוב בשפה"@he .


###  http://www.cidoc-crm.org/cidoc-crm/P74_has_current_or_former_residence
cidoc-crm:P74_has_current_or_former_residence rdf:type owl:ObjectProperty ;
                                              rdfs:domain cidoc-crm:E39_Actor ;
                                              rdfs:range cidoc-crm:E53_Place ;
                                              rdfs:label "has current or former residence"@en ,
                                                         "ממוקם ב"@he .


###  http://www.cidoc-crm.org/cidoc-crm/P7_took_place_at
cidoc-crm:P7_took_place_at rdf:type owl:ObjectProperty ;
                           rdfs:domain cidoc-crm:E7_Activity ;
                           rdfs:range cidoc-crm:E53_Place ;
                           rdfs:label "\"התרחש ב\""@he ,
                                      "took place at"@en .


###  http://www.cidoc-crm.org/cidoc-crm/P94_has_created
cidoc-crm:P94_has_created rdf:type owl:ObjectProperty ;
                          rdfs:domain cidoc-crm:E65_Creation ;
                          rdfs:range cidoc-crm:E28_Conceptual_Object ;
                          rdfs:label "has created"@en ,
                                     "יצר"@he .


###  http://www.ontology.org.il/HebrewManuscripts/2025-08-19#P44_has_condition
HebrewManuscripts:P44_has_condition rdf:type owl:ObjectProperty ;
                                    rdfs:range cidoc-crm:E55_Type ;
                                    rdfs:comment "This property describes the condition of an object (excellent, good, fair, poor, damaged)" ;
                                    rdfs:label "has condition"@en ,
                                               "מצב פיסי"@he .


###  http://www.ontology.org.il/HebrewManuscripts/2025-08-19#has_Script_Mode
HebrewManuscripts:has_Script_Mode rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf owl:topObjectProperty ;
                                  rdfs:domain lrmoo:F4_Manifestation_Singleton ;
                                  rdfs:range cidoc-crm:E55_Type ;
                                  rdfs:label "Scripts Types/Modes"@en ,
                                             "סוג הכתב (מרובע, בינוני,רהוט)"@he .


###  http://www.ontology.org.il/HebrewManuscripts/2025-08-19#has_colophon
HebrewManuscripts:has_colophon rdf:type owl:ObjectProperty ;
                               rdfs:domain lrmoo:F4_Manifestation_Singleton ;
                               rdfs:range HebrewManuscripts:Colophon ;
                               rdfs:label "has colophon@en" ,
                                          "יש קולופון@he" .


###  http://www.ontology.org.il/HebrewManuscripts/2025-08-19#has_date_of_creation
HebrewManuscripts:has_date_of_creation rdf:type owl:ObjectProperty ;
                                       rdfs:domain lrmoo:F4_Manifestation_Singleton ;
                                       rdfs:range cidoc-crm:E52_Time-Span .


###  http://www.ontology.org.il/HebrewManuscripts/2025-08-19#has_material
HebrewManuscripts:has_material rdf:type owl:ObjectProperty ;
                               rdfs:domain lrmoo:F4_Manifestation_Singleton ;
                               rdfs:range cidoc-crm:E57_Material ;
                               rdfs:label "has material@en" ,
                                          "חומר@he" .


###  http://www.ontology.org.il/HebrewManuscripts/2025-08-19#has_script_type
HebrewManuscripts:has_script_type rdf:type owl:ObjectProperty ;
                                  rdfs:domain lrmoo:F4_Manifestation_Singleton ;
                                  rdfs:range cidoc-crm:E55_Type ;
                                  rdfs:label "has script type@en" ,
                                             "סוג כתב@he" .


###  http://www.ontology.org.il/HebrewManuscripts/2025-08-19#mentions_date
HebrewManuscripts:mentions_date rdf:type owl:ObjectProperty ;
                                rdfs:domain HebrewManuscripts:Colophon ;
                                rdfs:range cidoc-crm:E52_Time-Span .


###  http://www.ontology.org.il/HebrewManuscripts/2025-08-19#mentions_person
HebrewManuscripts:mentions_person rdf:type owl:ObjectProperty ;
                                  rdfs:domain lrmoo:F4_Manifestation_Singleton ;
                                  rdfs:range cidoc-crm:E21_Person ;
                                  rdfs:label "שם אדם שמוזכר בכתב היד." .


###  http://www.ontology.org.il/HebrewManuscripts/2025-08-19#mentions_place
HebrewManuscripts:mentions_place rdf:type owl:ObjectProperty ;
                                 rdfs:domain HebrewManuscripts:Colophon ;
                                 rdfs:range cidoc-crm:E53_Place .


###  http://www.ontology.org.il/HebrewManuscripts/2025-08-19#mentions_scribe
HebrewManuscripts:mentions_scribe rdf:type owl:ObjectProperty ;
                                  rdfs:domain HebrewManuscripts:Colophon ;
                                  rdfs:range cidoc-crm:E21_Person ;
                                  rdfs:label "סופר מוזכר"@he ,
                                             "mentions scribe@en" .


#################################################################
#    Data properties
#################################################################

###  http://www.cidoc-crm.org/cidoc-crm/P190_has_symbolic_content
cidoc-crm:P190_has_symbolic_content rdf:type owl:DatatypeProperty ;
                                    rdfs:domain cidoc-crm:E33_Linguistic_Object ;
                                    rdfs:range xsd:string ;
                                    rdfs:comment "This property allows for the direct linking of an E62 String with its string content\"" ;
                                    rdfs:label "has symbolic content" .


###  http://www.cidoc-crm.org/cidoc-crm/P82a_begin_of_the_begin
cidoc-crm:P82a_begin_of_the_begin rdf:type owl:DatatypeProperty ;
                                  rdfs:domain cidoc-crm:E21_Person ;
                                  rdfs:range xsd:integer ;
                                  rdfs:label "end of the end"@en ,
                                             "סוף הסוף"@he .


###  http://www.cidoc-crm.org/cidoc-crm/P82b_end_of_the_end
cidoc-crm:P82b_end_of_the_end rdf:type owl:DatatypeProperty ;
                              rdfs:domain cidoc-crm:E21_Person ;
                              rdfs:range xsd:integer ;
                              rdfs:label "end of the end"@en ,
                                         "סוף הסוף"@he .


###  http://www.ontology.org.il/HebrewManuscripts/2025-08-19#colophon_text
HebrewManuscripts:colophon_text rdf:type owl:DatatypeProperty ;
                                rdfs:domain HebrewManuscripts:Colophon ;
                                rdfs:range xsd:string .


###  http://www.ontology.org.il/HebrewManuscripts/2025-08-19#date_attribution_source
HebrewManuscripts:date_attribution_source rdf:type owl:DatatypeProperty ;
                                          rdfs:range xsd:string ;
                                          rdfs:comment "Values: \"colophon\", \"paleographic\", \"historical\", \"catalog\"" ;
                                          rdfs:label "מקור ייחוס התאריך"@he ,
                                                     "date attribution source@en" .


###  http://www.ontology.org.il/HebrewManuscripts/2025-08-19#earliest_possible_date
HebrewManuscripts:earliest_possible_date rdf:type owl:DatatypeProperty ;
                                         rdfs:domain cidoc-crm:E52_Time-Span ;
                                         rdfs:range xsd:integer ;
                                         rdfs:label "earliest possible date"@en ,
                                                    "תאריך מוקדם ביותר"@he .


###  http://www.ontology.org.il/HebrewManuscripts/2025-08-19#external_identifier_nli
HebrewManuscripts:external_identifier_nli rdf:type owl:DatatypeProperty ;
                                          rdfs:domain lrmoo:F4_Manifestation_Singleton ;
                                          rdfs:range xsd:string ;
                                          rdfs:comment "Identifier from National Library of Israel authorities" ;
                                          rdfs:label "NLI Identifier"@en ,
                                                     "מזהה NLI"@he .


###  http://www.ontology.org.il/HebrewManuscripts/2025-08-19#external_uri_nli
HebrewManuscripts:external_uri_nli rdf:type owl:DatatypeProperty ;
                                   rdfs:domain HebrewManuscripts:SubjectType ;
                                   rdfs:range xsd:anyURI ;
                                   rdfs:comment "URI from National Library of Israel authorities" ;
                                   rdfs:label "NLI URI"@en ,
                                              "קישור NLI"@he .


###  http://www.ontology.org.il/HebrewManuscripts/2025-08-19#external_wikidata_id
HebrewManuscripts:external_wikidata_id rdf:type owl:DatatypeProperty ;
                                       rdfs:subPropertyOf owl:topDataProperty ;
                                       rdfs:domain owl:Thing ;
                                       rdfs:range xsd:string ;
