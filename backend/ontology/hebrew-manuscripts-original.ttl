#################################################################

###  http://iflastandards.info/ns/lrm/lrmoo/F3_Manifestation
lrmoo:F3_Manifestation rdfs:subClassOf cidoc-crm:E22_Human-Made_Object .


###  http://iflastandards.info/ns/lrm/lrmoo/F4_Manifestation_Singleton
lrmoo:F4_Manifestation_Singleton rdf:type owl:Class ;
                                 owl:equivalentClass <http://iflastandards.info/ns/lrmoo/F5_Item> ;
                                 rdfs:subClassOf lrmoo:F3_Manifestation ;
                                 rdfs:comment "A unique physical object that embodies an expression"@en ,
                                              """In LRMoo: F4 Deprecated. Merged with F3 Manifestation and 
requires a single instance of F5 Item to be instantiated""" ;
                                 rdfs:label "Manifestation Singleton"@en ,
                                            "עותק יחיד"@he .


###  http://iflastandards.info/ns/lrmoo/F27_Work_Creation
<http://iflastandards.info/ns/lrmoo/F27_Work_Creation> rdf:type owl:Class ;
                                                       rdfs:subClassOf cidoc-crm:E65_Creation ;
                                                       rdfs:label "פעולה שיצרה Work (רעיון / תוכן מופשט)."@he .


###  http://iflastandards.info/ns/lrmoo/F28_Expression_Creation
<http://iflastandards.info/ns/lrmoo/F28_Expression_Creation> rdf:type owl:Class ;
                                                             rdfs:subClassOf cidoc-crm:E12_Production ,
                                                                             cidoc-crm:E65_Creation ;
                                                             rdfs:label "פעולה שיצרה Expression (נוסח מסוים של עבודה)."@he .


###  http://iflastandards.info/ns/lrmoo/F30_Manifestation_Creation
<http://iflastandards.info/ns/lrmoo/F30_Manifestation_Creation> rdf:type owl:Class ;
                                                                rdfs:subClassOf cidoc-crm:E12_Production ,
                                                                                cidoc-crm:E65_Creation ;
                                                                rdfs:label "פעולה שיצרה Manifestation (ייצוג פיזי כללי, כמו כתב־יד או דפוס)."@he .


###  http://iflastandards.info/ns/lrmoo/F32_Item_Production_Event
<http://iflastandards.info/ns/lrmoo/F32_Item_Production_Event> rdf:type owl:Class ;
                                                               rdfs:subClassOf cidoc-crm:E65_Creation ;
                                                               rdfs:label "פעולה שייצרה Item יחיד ומוחשי (עותק מסוים)."@he .


###  http://iflastandards.info/ns/lrmoo/F5_Item
<http://iflastandards.info/ns/lrmoo/F5_Item> rdf:type owl:Class ;
                                             rdfs:subClassOf cidoc-crm:E18_Physical_Thing ;
                                             rdfs:comment "rdfs:comment \"In FRBRoo, F4 Manifestation Singleton is a subclass of F3 Manifestation. In LRMoo, F4 was deprecated and replaced by F5 Item (subclass of E18 Physical Thing). Here F4 is retained for continuity but declared equivalent to F5 to ensure interoperability.\"@en ."@en ,
                                                          "rdfs:comment \"ב-FRBRoo המחלקה F4 Manifestation Singleton הוגדרה כתת-מחלקה של F3 Manifestation. ב-LRMoo בוטלה F4 והוחלפה ב-F5 Item כתת-מחלקה של E18 Physical Thing. כאן נשמרת F4 לצורך רצף, אך הוגדרה כשקולה ל-F5 לצורך תאימות.\"@he ."@he ;
                                             rdfs:label "Item"@en .


###  http://www.cidoc-crm.org/cidoc-crm/E10_Transfer_of_Custody
cidoc-crm:E10_Transfer_of_Custody rdf:type owl:Class ;
                                  rdfs:subClassOf cidoc-crm:E7_Activity ;
                                  rdfs:label "Transfer of Custody@en" ,
                                             "העברת משמורת@he" .


###  http://www.cidoc-crm.org/cidoc-crm/E12_Production
cidoc-crm:E12_Production rdf:type owl:Class ;
                         rdfs:subClassOf cidoc-crm:E7_Activity ;
                         rdfs:label "אירוע יצירת כתב היד"@he ,
                                    "Production@en" .


###  http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing
cidoc-crm:E18_Physical_Thing rdf:type owl:Class ;
                             rdfs:subClassOf cidoc-crm:E1_CRM_Entity ;
                             rdfs:label "Physical Thing"@en ,
                                        "דבר פיסי"@he .


###  http://www.cidoc-crm.org/cidoc-crm/E1_CRM_Entity
cidoc-crm:E1_CRM_Entity rdfs:subClassOf owl:Thing .


###  http://www.cidoc-crm.org/cidoc-crm/E21_Person
cidoc-crm:E21_Person rdfs:subClassOf cidoc-crm:E39_Actor ;
                     rdfs:comment """This class comprises real persons who live or are assumed to have lived.

Legendary figures that may have existed, such as Ulysses and King Arthur, fall into this class if the documentation refers to them as historical figures. In cases where doubt exists as to whether several persons are in fact identical, multiple instances can be created and linked to indicate their relationship. The CIDOC CRM does not propose a specific form to support reasoning about possible identity.

In a bibliographic context, a name presented following the conventions usually employed for personal names will be assumed to correspond to an actual real person (an instance of E21 Person), unless evidence is available to indicate that this is not the case. The fact that a persona may erroneously be classified as an instance of E21 Person does not imply that the concept comprises personae.""" ;
                     rdfs:label "Person"@en ,
                                "אדם"@he .


###  http://www.cidoc-crm.org/cidoc-crm/E22_Human-Made_Object
cidoc-crm:E22_Human-Made_Object rdfs:subClassOf cidoc-crm:E18_Physical_Thing .


###  http://www.cidoc-crm.org/cidoc-crm/E28_Conceptual_Object
cidoc-crm:E28_Conceptual_Object rdfs:subClassOf cidoc-crm:E1_CRM_Entity .


###  http://www.cidoc-crm.org/cidoc-crm/E31_Document
cidoc-crm:E31_Document rdf:type owl:Class ;
                       rdfs:subClassOf cidoc-crm:E7_Activity ;
                       rdfs:comment "E31_Document - מיועד לפעילויות של יצירת מסמכים/דיגיטציה:" ;
                       rdfs:label "Document@en" ,
                                  "מסמך@he" .


###  http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object
cidoc-crm:E33_Linguistic_Object rdf:type owl:Class ;
                                rdfs:subClassOf cidoc-crm:E28_Conceptual_Object ;
                                rdfs:comment "This class comprises identifiable expressions in natural language"@en ;
                                rdfs:label "Linguistic Object"@en .


###  http://www.cidoc-crm.org/cidoc-crm/E35_Title
cidoc-crm:E35_Title rdf:type owl:Class ;
                    rdfs:subClassOf cidoc-crm:E33_Linguistic_Object ;
                    rdfs:comment """מיועד לתיאור כותרות או שמות המוקצים לעבודות יצירתיות, ביטויים, או ביטויים פיזיים. 
כותרת היא זיהוי לשוני שמבחין בין יצירה אחת לאחרת או בין ביטוי אחד למשנהו."""@he ;
                    rdfs:label "Title"@en ,
                               "כותר"@he .


###  http://www.cidoc-crm.org/cidoc-crm/E39_Actor
cidoc-crm:E39_Actor rdfs:subClassOf cidoc-crm:E1_CRM_Entity .


###  http://www.cidoc-crm.org/cidoc-crm/E41_Appellation
cidoc-crm:E41_Appellation rdfs:subClassOf cidoc-crm:E1_CRM_Entity .


###  http://www.cidoc-crm.org/cidoc-crm/E42_Identifier
cidoc-crm:E42_Identifier rdf:type owl:Class ;
                         rdfs:subClassOf cidoc-crm:E41_Appellation ;
                         rdfs:label "Identifier@en"@en ,
                                    "מזהה"@he .


###  http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span
cidoc-crm:E52_Time-Span rdfs:subClassOf cidoc-crm:E1_CRM_Entity ;
                        rdfs:comment """E52 הוא מחלקה גנרית של CIDOC CRM לכל טווח זמן.

F10 יורש/מתבסס על E52 ומיועד במיוחד להקשרים ביבליוגרפיים לפי LRMoo (למשל זמן יצירה של Work, זמן פרסום, וכו’).

📌 לכן:

אם את עובדת בעיקר עם LRMoo (כפי שאמרת), כדאי להיצמד ל־F10_Time-span ולהשתמש בו כסטנדרט.

E52 נשאר רקע/היררכיה כללית — אין צורך להשתמש בו ישירות אם F10 נותן לך את המענה.

הכפילות עצמה לא \"טעות\" – זה פשוט כי LRMoo יורש מ־CRM – אבל בפרקטיקה כדאי לבחור אחד לעבודה שוטפת, אחרת זה מבלבל את המודל.

👉 ההמלצה שלי:

תשאירי את E52 כ־Superclass במבנה (כי ככה מוגדר הסטנדרט),

אבל תשתמשי רק ב־F10 כדי לייצג טווחי זמן ממשיים בנתונים שלך (למשל: \"1248–1305\", \"שבט קס\"ז 1407\").""" .


###  http://www.cidoc-crm.org/cidoc-crm/E53_Place
cidoc-crm:E53_Place rdfs:subClassOf cidoc-crm:E1_CRM_Entity ;
                    rdfs:comment """E53 Place – מחלקה גנרית של CIDOC CRM לכל מקום (עיר, אזור, מדינה, אתר).

F11 Place – הרחבה של LRMoo/FRBRoo ל־Place בהקשר ביבליוגרפי/ספרותי (מקום יצירה, מקום כתיבה, מקום פרסום).

🔑 מה שקורה בפועל:

E53 נשאר ה־Superclass הכללי (שממנו יורש F11).

F11 מותאם למודל שלך (כי את מתארת כתבי יד, מקומות כתיבה, שימור וכו’).

📌 ההמלצה:

תמשיכי לעבוד עם F11 Place בנתונים עצמם (כמו “קנדיה”, “אירקליו”, “ותיקן”).

תשאירי את E53 Place ברקע במבנה (אי אפשר למחוק אותו, כי זה חלק מה־CRM).

כך שמה שציינת נכון — בדיוק כמו עם Time-span, עדיף להתבסס בפרקטיקה על המחלקה הייעודית (F11), ולתת ל־E53/E52 להישאר בתור ירושה כללית.""" .


